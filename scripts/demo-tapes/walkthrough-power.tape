Output site/public/videos/walkthrough-power.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 45ms

Type "cd ~/demo/dc-app"
Enter
Type "dc up"
Enter
Sleep 2s
Type "dc db"
Enter
Sleep 1500ms
Type "dc files"
Enter
Sleep 1500ms
Type "q"
Sleep 500ms
Type "dc stats"
Enter
Sleep 2s
Type "dc ls"
Enter
Sleep 2s
