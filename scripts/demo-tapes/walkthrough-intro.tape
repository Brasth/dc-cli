Output site/public/videos/walkthrough-intro.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 40ms

Type "cd ~/demo/dc-app"
Enter
Sleep 500ms
Type "dc"
Enter
Sleep 2s
Type "q"
Sleep 300ms
Type "dc up"
Enter
Sleep 3s
Type "dc exec"
Enter
Sleep 2s
Type "exit"
Enter
Sleep 500ms
Type "dc.brasth.com"
Sleep 2s
