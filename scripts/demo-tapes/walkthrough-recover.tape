Output site/public/videos/walkthrough-recover.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 45ms

Type "cd ~/demo/dc-app"
Enter
Type "dc doctor"
Enter
Sleep 2s
Type "dc recover"
Enter
Sleep 2s
Type "dc recover --yes"
Enter
Sleep 3s
Type "dc doctor"
Enter
Sleep 2s
