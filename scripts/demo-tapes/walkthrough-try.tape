Output site/public/videos/walkthrough-try.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 45ms

Type "mkdir -p /tmp/dc-empty && cd /tmp/dc-empty"
Enter
Type "dc up"
Enter
Sleep 1500ms
Type "dc try"
Enter
Sleep 2s
Type "dc exec"
Enter
Sleep 1500ms
Type "exit"
Enter
Sleep 1s
