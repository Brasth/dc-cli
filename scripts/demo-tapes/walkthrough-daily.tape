Output site/public/videos/walkthrough-daily.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 45ms

Type "cd ~/demo/dc-app"
Enter
Type "dc up"
Enter
Sleep 2s
Type "dc exec"
Enter
Sleep 1500ms
Type "exit"
Enter
Type "dc down"
Enter
Sleep 1500ms
Type "cd ~/demo/dc-compose && dc up"
Enter
Sleep 2s
Type "dc down"
Enter
Sleep 1s
