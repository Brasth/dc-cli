Output site/public/videos/walkthrough-board.mp4

Set Width 1280
Set Height 720
Set FontSize 18
Set Theme "Catppuccin Mocha"
Set Padding 40
Set Margin 20
Set Shell bash
Set TypingSpeed 35ms

Type "export DC_TUI_NO_SPLASH=1"
Enter
Type "cd ~/demo/dc-app && dc"
Enter
Sleep 3s
Type "u"
Sleep 2s
Type "l"
Sleep 2s
Type "t"
Sleep 2s
Type "q"
Sleep 500ms
Type "dc --all"
Enter
Sleep 3s
Type "q"
Sleep 1s
