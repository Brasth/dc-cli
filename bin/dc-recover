#!/usr/bin/env bash
# Diagnose the host, print one next step, optionally apply it.
# Doctor stays read-only. This is the mutate door.
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"
_load() {
  local name="$1"
  if [[ -f "$_here/../lib/$name" ]]; then
    # shellcheck source=/dev/null
    source "$_here/../lib/$name"
  elif [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/dc-cli/generations/current/lib/$name" ]]; then
    # shellcheck source=/dev/null
    source "${XDG_DATA_HOME:-$HOME/.local/share}/dc-cli/generations/current/lib/$name"
  elif [[ -f "${HOME}/.config/devcontainer/$name" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.config/devcontainer/$name"
  else
    echo "dc-recover: missing $name" >&2
    exit 1
  fi
}

_load dc-common.sh
_load dc-engine.sh
_load dc-host.sh
_load dc-net.sh
_load dc-recover.sh

json=0
yes=0
report=""
workspace="."
grow=""

usage() {
  cat <<'EOF'
dc-recover — one next step when Docker (or this folder) is blocking dc-cli

  dc-recover [workspace]         diagnose + print the next command
  dc-recover --json [workspace]  machine-readable plan
  dc-recover --yes [workspace]   apply the next allowlisted action, then recheck
  dc-recover --grow-disk [N]     plan/apply Colima disk grow (default 60)
  dc-recover --report [dir]      write a redacted bundle (default ./dc-recover-report)
  dc-recover --help

v1 attaches to an engine you already have (start, pick-one, context, group,
safe prune). It does not install Docker. Doctor stays read-only.

Never: docker system prune -af --volumes, unlabeled mass-stop, systemctl
disable --now, rewriting ~/.zshrc.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) json=1 ;;
    --yes|-y) yes=1 ;;
    --grow-disk)
      if [[ $# -ge 2 && "$2" != -* ]]; then
        grow="$2"
        shift
      else
        grow="${DC_RECOVER_DISK_GIB:-60}"
      fi
      ;;
    --report)
      if [[ $# -ge 2 && "$2" != -* ]]; then
        report="$2"
        shift
      else
        report="dc-recover-report"
      fi
      ;;
    --version|-V) dc_cli_print_version "$(basename "$0")"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      workspace="$1"
      ;;
  esac
  shift
done

if [[ -n "$grow" ]]; then
  DC_RECOVER_DISK_GIB="$grow"
fi

if [[ "${DC_RECOVER_SKIP_DIAGNOSE:-}" != "1" ]]; then
  if [[ "$workspace" != "." && ! -d "$workspace" ]]; then
    echo "Not a directory: $workspace" >&2
    exit 2
  fi
  if [[ "$workspace" != "." ]]; then
    cd "$workspace"
  fi
  dc_host_diagnose
  if [[ "${DC_HOST_CODE:-}" == "ready" ]]; then
    dc_recover_folder_diagnose "$workspace"
  fi
fi

if [[ -n "$grow" ]]; then
  if [[ "${DC_HOST_ENGINE_HINT:-}" != "colima" ]]; then
    echo "dc-recover: --grow-disk only applies when Colima is the selected engine (hint=${DC_HOST_ENGINE_HINT:-unknown})" >&2
    exit 1
  fi
  if [[ "${DC_HOST_CODE:-}" != "ready" ]]; then
    echo "dc-recover: --grow-disk needs a reachable Colima engine" >&2
    exit 1
  fi
  if [[ "${DC_RECOVER_FOLDER_HINT:-}" != "colima_full" ]]; then
    echo "dc-recover: --grow-disk needs Colima guest disk >=95% (after prune)" >&2
    exit 1
  fi
fi

dc_recover_plan

if [[ -n "$report" ]]; then
  dc_recover_write_report "$report"
  echo "dc-recover: wrote $report"
  [[ "${DC_HOST_CODE:-}" == "ready" && "${DC_RECOVER_ID:-}" == "ready" ]] && exit 0
  exit 0
fi

if [[ "$json" -eq 1 && "$yes" -eq 0 ]]; then
  dc_recover_json
elif [[ "$json" -eq 0 ]]; then
  dc_recover_print_human
fi

if [[ "$yes" -eq 1 ]]; then
  if [[ "${DC_RECOVER_APPLY_ALLOWED:-0}" != "1" || "${DC_RECOVER_APPLY:-none}" == "none" ]]; then
    echo "dc-recover: nothing safe to apply" >&2
    exit 1
  fi
  apply_rc=0
  if [[ "$json" -eq 1 ]]; then
    dc_recover_apply "${DC_RECOVER_APPLY}" >&2 || apply_rc=$?
  else
    dc_recover_apply "${DC_RECOVER_APPLY}" || apply_rc=$?
  fi
  if [[ "${DC_RECOVER_SKIP_DIAGNOSE:-}" != "1" ]]; then
    dc_host_diagnose
    if [[ "${DC_HOST_CODE:-}" == "ready" ]]; then
      dc_recover_folder_diagnose "$workspace"
    fi
  fi
  dc_recover_plan
  if [[ "$json" -eq 1 ]]; then
    dc_recover_json
  else
    echo
    dc_recover_print_human
  fi
  if [[ "$apply_rc" -ne 0 ]]; then
    exit 1
  fi
  if [[ "${DC_HOST_CODE:-}" == "ready" && "${DC_RECOVER_ID:-}" == "ready" ]]; then
    exit 0
  fi
  exit 1
fi

if [[ "${DC_HOST_CODE:-}" == "ready" && "${DC_RECOVER_ID:-}" == "ready" ]]; then
  exit 0
fi
exit 1
