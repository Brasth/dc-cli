#!/usr/bin/env bash
# Stop/remove official @devcontainers/cli containers + compose siblings.
# The CLI (v0.87) has no `down` command.
#
# Usage:
#   dc-down [workspace]              # full compose stack (app + db + mitm + …)
#   dc-down --app [workspace]        # labeled app only
#   dc-down --rm [--volumes] [dir]
#   dc-down --id CONTAINER
#   dc-down --all --yes
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$_here/../lib/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-common.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-common.sh"
else
  echo "dc-common.sh not found (install.sh copies it to ~/.config/devcontainer/)" >&2
  exit 1
fi

remove=0
volumes=0
all=0
yes=0
# Default: whole compose project (mitm/db/mailpit), not just the labeled app.
# --app keeps the old app-only behavior.
stack=1
app_only=0
workspace="."
explicit_id=""

usage() {
  cat <<'EOF'
dc-down — stop/remove the workspace stack (official CLI has no down)

  dc-down [workspace]          stop the FULL compose project
                               (app + db + wordpress + mitm + … + dc-forward)
  dc-down --app [workspace]    stop only the labeled app (+ its sidecars)
  dc-down --rm [workspace]     stop + remove (compose down / docker rm)
  dc-down --volumes            also remove volumes (compose down -v / rm -v)
  dc-down --id NAME_OR_ID      target one container only
  dc-down --compose            same as default (kept for scripts)
  dc-down --all --yes          every labeled workspace stack
  dc-down --help

Why full stack by default:
  Host ports (e.g. 9001 on wordpress-mitm) stay allocated if only the app
  is stopped. That blocks dc-up of another project on the same ports.

--all is nuclear; requires --yes or DC_DOWN_YES=1.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rm) remove=1 ;;
    --volumes|-v) volumes=1; remove=1 ;;
    --all) all=1 ;;
    --yes|-y) yes=1 ;;
    --app)
      app_only=1
      stack=0
      ;;
    --compose)
      # alias for default full-stack (backward compatible)
      stack=1
      app_only=0
      ;;
    --id)
      shift
      [[ $# -ge 1 ]] || { echo "--id needs a container" >&2; exit 2; }
      explicit_id="$1"
      ;;
    -h|--help) usage; exit 0 ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -d "$1" ]]; then
        workspace="$1"
      elif docker inspect "$1" >/dev/null 2>&1; then
        explicit_id="$1"
      else
        echo "Unknown arg (not a dir or container): $1" >&2
        exit 2
      fi
      ;;
  esac
  shift
done

if [[ "$all" -eq 1 && "${DC_DOWN_YES:-}" == "1" ]]; then
  yes=1
fi
if [[ "$all" -eq 1 && "$yes" -ne 1 ]]; then
  echo "Refusing --all without --yes (or DC_DOWN_YES=1)." >&2
  exit 2
fi

# --id is always a single container (unless that container is only used to
# discover a compose project when --compose/--stack default and no --app).
# Explicit id without --app: stop that one box only (predictable).
if [[ -n "$explicit_id" && "$app_only" -eq 0 && "$stack" -eq 1 ]]; then
  # If user passed a path-less id, keep single-container semantics unless
  # they also asked for full stack via staying on default with a workspace.
  # Single id → app-only for safety.
  app_only=1
  stack=0
fi

ids=()

if [[ -n "$explicit_id" ]]; then
  ids=("$explicit_id")
elif [[ "$all" -eq 1 ]]; then
  mapfile -t ids < <(dc_labeled_ids)
else
  mapfile -t ids < <(dc_ids_for_workspace "$workspace")
fi

cleaned=()
for id in "${ids[@]+"${ids[@]}"}"; do
  [[ -n "${id:-}" ]] && cleaned+=("$id")
done
if [[ ${#cleaned[@]} -eq 0 ]]; then
  echo "No matching devcontainer."
  exit 0
fi
ids=("${cleaned[@]}")

drop_sidecars() {
  local id="$1" fwd fid
  fwd="$(command -v dc-forward 2>/dev/null || true)"
  if [[ -z "$fwd" && -x "$_here/dc-forward" ]]; then
    fwd="$_here/dc-forward"
  fi
  if [[ -n "$fwd" ]]; then
    "$fwd" --stop --id "$id" >/dev/null 2>&1 || true
  else
    while IFS= read -r fid; do
      [[ -n "$fid" ]] || continue
      docker rm -f "$fid" >/dev/null 2>&1 || true
    done < <(docker ps -aq --filter "label=dc.forward.for=${id}" 2>/dev/null)
  fi
}

compose_projects=()
declare -A compose_seen=()

queue_compose() {
  local proj="$1"
  [[ -n "$proj" && "$proj" != "<no value>" ]] || return 0
  [[ -n "${compose_seen[$proj]:-}" ]] && return 0
  compose_seen[$proj]=1
  compose_projects+=("$proj")
}

stop_app_only() {
  local id="$1"
  local name status folder
  name="$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')" || name="?"
  status="$(docker inspect -f '{{.State.Status}}' "$id" 2>/dev/null || echo missing)"
  folder="$(docker inspect -f "{{index .Config.Labels \"${DC_LABEL_FOLDER}\"}}" "$id" 2>/dev/null || true)"
  [[ "$folder" == "<no value>" ]] && folder=""

  drop_sidecars "$id"

  if [[ "$status" == "running" ]]; then
    docker stop "$id" >/dev/null
    echo "$id  $name  folder=${folder:-}  stopped (app only)"
  elif [[ "$status" == "missing" ]]; then
    echo "$id  missing" >&2
    return
  else
    echo "$id  $name  folder=${folder:-}  already ${status} (app only)"
  fi

  if [[ "$remove" -eq 1 ]]; then
    if [[ "$volumes" -eq 1 ]]; then
      docker rm -v "$id" >/dev/null 2>&1 || docker rm "$id" >/dev/null 2>&1 || true
      echo "$id  removed (+ anonymous volumes)"
    else
      docker rm "$id" >/dev/null 2>&1 || true
      echo "$id  removed"
    fi
  fi
}

for id in "${ids[@]}"; do
  name="$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')" || name="?"
  folder="$(docker inspect -f "{{index .Config.Labels \"${DC_LABEL_FOLDER}\"}}" "$id" 2>/dev/null || true)"
  proj="$(docker inspect -f "{{index .Config.Labels \"${DC_LABEL_COMPOSE}\"}}" "$id" 2>/dev/null || true)"
  [[ "$folder" == "<no value>" ]] && folder=""
  [[ "$proj" == "<no value>" ]] && proj=""

  # Always free sidecars for this labeled app.
  drop_sidecars "$id"

  if [[ "$stack" -eq 1 && -n "$proj" ]]; then
    queue_compose "$proj"
    echo "$id  $name  compose=$proj  folder=${folder:-}  (full stack)"
    continue
  fi

  # No compose label, or --app: single container.
  stop_app_only "$id"
done

if [[ ${#compose_projects[@]} -gt 0 ]]; then
  for proj in "${compose_projects[@]}"; do
    if [[ "$remove" -eq 1 ]]; then
      if [[ "$volumes" -eq 1 ]]; then
        docker compose -p "$proj" down -v
      else
        docker compose -p "$proj" down
      fi
      echo "compose $proj  down (all services)"
    else
      docker compose -p "$proj" stop
      echo "compose $proj  stopped (all services)"
    fi
  done
fi
