#!/usr/bin/env bash
# Open a file manager *inside* the container. Prefer one already in the image;
# otherwise copy a cached Linux yazi into /tmp (never apt-get).
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$_here/../lib/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-common.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-common.sh"
else
  echo "dc-common.sh not found (install.sh copies it to ~/.config/devcontainer/)" >&2
  exit 1
fi
if [[ -f "$_here/../lib/dc-install-yazi.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-install-yazi.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-install-yazi.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-install-yazi.sh"
fi
if [[ -f "$_here/../lib/dc-files-open.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-files-open.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-files-open.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-files-open.sh"
fi

workspace="."
service=""
explicit_id=""
start_path=""
tools=(yazi nnn lf mc ranger)

usage() {
  cat <<'EOF'
dc-files — open a file manager inside the container

  dc-files [workspace]                 labeled app
  dc-files --service NAME [workspace]  that compose service
  dc-files --id NAME_OR_ID
  dc-files --path DIR [...]            start directory inside the box

Detects $DC_FILES_TOOL, then yazi, nnn, lf, mc, ranger in the box.
If none, copies a Linux yazi into /tmp and runs that (never apt-get).
Enter / double-click opens the file in code/cursor (this container).
No attach editor: bind-mount host path via zed/subl. Hatch: DC_FILES_EDITOR=vim.
Force one: DC_FILES_EDITOR=code|cursor. Cursor needs kind=devcontainer.
Bind-mount folder editor on the host: dc-open.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --service|-s)
      shift
      [[ $# -ge 1 ]] || { echo "--service needs a name" >&2; exit 2; }
      service="$1"
      ;;
    --id)
      shift
      [[ $# -ge 1 ]] || { echo "--id needs a container" >&2; exit 2; }
      explicit_id="$1"
      ;;
    --path)
      shift
      [[ $# -ge 1 ]] || { echo "--path needs a directory" >&2; exit 2; }
      start_path="$1"
      ;;
    --version|-V) dc_cli_print_version "$(basename "$0")"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      workspace="$1"
      ;;
  esac
  shift
done

if [[ -n "${DC_FILES_TOOL:-}" ]]; then
  if [[ "${DC_FILES_TOOL}" == *[!A-Za-z0-9._-]* ]]; then
    echo "dc-files: DC_FILES_TOOL must be a simple command name" >&2
    exit 2
  fi
  tools=("$DC_FILES_TOOL" "${tools[@]}")
fi

resolve_id() {
  local id name status svc image
  if [[ -n "$explicit_id" ]]; then
    if ! docker inspect "$explicit_id" >/dev/null 2>&1; then
      echo "Container not found: $explicit_id" >&2
      return 1
    fi
    printf '%s\n' "$explicit_id"
    return 0
  fi
  if [[ -n "$service" ]]; then
    while IFS=$'\t' read -r id name status svc image; do
      [[ -n "$id" ]] || continue
      if [[ "$svc" == "$service" || "$name" == "$service" || "$id" == "$service"* ]]; then
        printf '%s\n' "$id"
        return 0
      fi
    done < <(dc_stack_rows "$workspace")
    echo "No compose service \"$service\" in this workspace stack. Try: dc-exec --list" >&2
    return 1
  fi
  id="$(dc_ids_for_workspace "$workspace" | head -n1)"
  if [[ -z "$id" ]]; then
    echo "dc-files: no labeled app in $workspace (dc-up first)" >&2
    return 1
  fi
  printf '%s\n' "$id"
}

# Labeled app: official dc-exec (remoteUser, cwd). Siblings: --id / --service.
use_official=0
target=""
if [[ -z "$explicit_id" && -z "$service" ]]; then
  use_official=1
else
  target="$(resolve_id)" || exit 1
  dc_ensure_running "$target" || exit 1
fi

found=""
for tool in "${tools[@]}"; do
  [[ -n "$tool" ]] || continue
  if [[ "$use_official" -eq 1 ]]; then
    if dc-exec "$workspace" -- sh -lc "command -v ${tool}" >/dev/null 2>&1; then
      found="$tool"
      break
    fi
  elif dc-exec --id "$target" -- sh -lc "command -v ${tool}" >/dev/null 2>&1; then
    found="$tool"
    break
  fi
done

if [[ -z "$found" ]]; then
  if [[ "${DC_FILES_NO_INJECT:-}" == "1" ]]; then
    echo "dc-files: no file manager in this container (tried ${tools[*]})." >&2
    exit 1
  fi
  if ! declare -F dc_inject_guest_yazi >/dev/null 2>&1; then
    echo "dc-files: no file manager in this container (tried ${tools[*]})." >&2
    echo "dc-install-yazi.sh missing; cannot inject Linux yazi." >&2
    exit 1
  fi
  inject_id="$target"
  if [[ "$use_official" -eq 1 ]]; then
    inject_id="$(dc_ids_for_workspace "$workspace" | head -n1)"
    if [[ -z "$inject_id" ]]; then
      echo "dc-files: no labeled app in $workspace (dc-up first)" >&2
      exit 1
    fi
    dc_ensure_running "$inject_id" || exit 1
  fi
  echo "dc-files: no file manager in this container; copying Linux yazi into the box" >&2
  if ! found="$(dc_inject_guest_yazi "$inject_id")"; then
    echo "dc-files: could not inject yazi. Use dc-open for the bind-mount." >&2
    exit 1
  fi
fi

if declare -F dc_files_run_fm >/dev/null 2>&1; then
  dc_files_run_fm "$use_official" "$workspace" "$target" "$found" "$start_path"
  exit $?
fi
if [[ "$use_official" -eq 1 ]]; then
  if [[ -n "$start_path" ]]; then
    exec dc-exec "$workspace" -- "$found" "$start_path"
  fi
  exec dc-exec "$workspace" -- "$found"
fi
if [[ -n "$start_path" ]]; then
  exec dc-exec --id "$target" -- "$found" "$start_path"
fi
exec dc-exec --id "$target" -- "$found"
