#!/usr/bin/env bash
# Start official @devcontainers/cli for a workspace.
# Default uses the PROJECT devcontainer.json (safe).
# --ports / --override REPLACE that file entirely (not a merge).
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$_here/../lib/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-common.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-common.sh"
else
  echo "dc-common.sh not found (install.sh copies it to ~/.config/devcontainer/)" >&2
  exit 1
fi
if [[ -f "$_here/../lib/dc-net.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-net.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-net.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-net.sh"
else
  echo "dc-net.sh not found" >&2
  exit 1
fi
if [[ -f "$_here/../lib/dc-engine.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-engine.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-engine.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-engine.sh"
else
  echo "dc-engine.sh not found" >&2
  exit 1
fi
if [[ -f "$_here/../lib/dc-host.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-host.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-host.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-host.sh"
fi

workspace="."
override=""
ports=0
no_forward=0
take_ports=0
create_nets=0
yes=0

usage() {
  cat <<'EOF'
dc-up — start a workspace with official @devcontainers/cli

  dc-up [workspace]              use project .devcontainer (safe default)
  dc-up --ports [workspace]      REPLACE config with ~/.config/devcontainer/override.json
  dc-up --override FILE [dir]    REPLACE config with FILE
  dc-up --no-forward             skip sidecar port publish after up
  dc-up --take-ports             if host ports clash, stop holders and retry (non-interactive)
  dc-up --create-nets            create missing declared external nets (does not take ports)
  dc-up --yes                    --take-ports + --create-nets for agents / CI
  dc-up --help

After a successful up, dc-up runs dc-forward (sidecar) so localhost:3000
works on Colima. DC_FORWARD=0 also skips that.

If a declared external network is missing, dc-up asks (TTY) or refuses
(non-TTY). --create-nets / --yes / DC_UP_CREATE_NETS=1 create default
bridge nets only. --create-nets does not take ports.

If compose fails with "port is already allocated", dc-up lists the container
holding that host port. On a TTY it asks whether to stop the holder and
retry. Use --take-ports / --yes to skip the prompt (or answer n to abort).

--ports / --override do NOT merge. Image, features, and mounts from the
project file are dropped. Prefer dc-forward for extra ports.

A folder with only a compose file (no .devcontainer) is compose-kind.
dc-up starts it with docker compose (no official CLI, no dc-forward).

If more than one Docker engine is live (Colima + Desktop, etc.),
dc-up refuses. Fix the CLI target, or DC_UP_ALLOW_SPLIT=1 to continue.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ports)
      ports=1
      override="${HOME}/.config/devcontainer/override.json"
      ;;
    --no-forward) no_forward=1 ;;
    --take-ports) take_ports=1 ;;
    --create-nets) create_nets=1 ;;
    --yes|-y)
      yes=1
      take_ports=1
      create_nets=1
      ;;
    --override)
      shift
      [[ $# -ge 1 ]] || { echo "--override needs a file" >&2; exit 2; }
      override="$1"
      ;;
    --version|-V) dc_cli_print_version "$(basename "$0")"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      workspace="$1"
      ;;
  esac
  shift
done

if [[ ! -d "$workspace" ]]; then
  echo "Not a directory: $workspace" >&2
  exit 2
fi
_up_ws="$(dc_resolve_workspace "$workspace")" || exit 2
_up_kind="$(dc_workspace_kind "$_up_ws")"
if [[ "$_up_kind" == "none" ]]; then
  echo "dc-up: this folder is not a workspace (no .devcontainer, no compose file)." >&2
  echo "dc-up: sandbox start without project config: dc-try \"$_up_ws\"" >&2
  if [[ "${yes:-0}" == "1" ]]; then
    echo "dc-up: --yes does not start a sandbox. Use: dc-try --yes \"$_up_ws\"" >&2
    exit 1
  fi
  if [[ "${DC_UP_TRY_PROMPT:-}" == "1" || -t 0 ]]; then
    printf 'Start a sandbox with dc-try? [y/N] ' >&2
    read -r _ans || _ans=
    if [[ "$_ans" == [yY] || "$_ans" == [yY][eE][sS] ]]; then
      exec dc-try --yes "$_up_ws"
    fi
    echo "dc-up: aborted" >&2
    exit 1
  fi
  echo "dc-up: non-interactive; start a sandbox with: dc-try --yes \"$_up_ws\"" >&2
  exit 1
fi
if [[ "$_up_kind" == "compose" && -n "$override" ]]; then
  echo "dc-up: --ports / --override are for Dev Container workspaces only." >&2
  exit 2
fi

if type dc_host_diagnose >/dev/null 2>&1; then
  dc_host_diagnose
  case "${DC_HOST_CODE:-}" in
    ready|docker_split_brain) ;;
    *)
      echo "dc-up: ${DC_HOST_SUMMARY:-Docker host not ready}" >&2
      dc_host_print_human >&2
      exit 1
      ;;
  esac
fi

if ! dc_engine_guard_up; then
  exit 1
fi

_dc_compose_up_locked() {
  local dir="$1" name="$2"
  shift 2
  (cd "$dir" && dc_docker_compose -p "$name" "$@" up -d)
}

dc_up_compose_kind() {
  local dir="$1"
  local name f n claimants
  local -a file_args=()
  ws="$dir"
  name="$(dc_compose_project_name "$dir")" || {
    echo "dc-up: cannot resolve compose project name" >&2
    return 1
  }
  n=0
  claimants=""
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    n=$((n + 1))
    claimants="${claimants}${claimants:+ }$f"
  done < <(dc_compose_claimants "$name")
  if [[ "$n" -gt 1 ]]; then
    echo "dc-up: refuse compose $name (claimants: $claimants)" >&2
    return 1
  fi
  if [[ "$n" -eq 1 ]] && ! dc_same_workspace "$claimants" "$dir" 2>/dev/null && [[ "$claimants" != "$dir" ]]; then
    echo "dc-up: compose $name belongs to $claimants, not $dir" >&2
    return 1
  fi
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    file_args+=(-f "$f")
  done < <(dc_compose_file_args "$dir")
  if [[ ${#file_args[@]} -eq 0 ]]; then
    echo "dc-up: no compose files in $dir" >&2
    return 1
  fi
  if ! ensure_declared_nets; then
    return 1
  fi
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  set +e
  dc_with_mutation_lock _dc_compose_up_locked "$dir" "$name" "${file_args[@]}" >"$tmp" 2>&1
  local rc=$?
  set -e
  cat "$tmp"
  if [[ "$rc" -ne 0 ]]; then
    handle_enospc "$tmp"
    if dc_log_is_port_conflict "$tmp"; then
      if resolve_port_conflict "$tmp"; then
        echo >&2
        echo "dc-up: retrying after freeing ports..." >&2
        set +e
        dc_with_mutation_lock _dc_compose_up_locked "$dir" "$name" "${file_args[@]}" >"$tmp" 2>&1
        rc=$?
        set -e
        cat "$tmp"
        if [[ "$rc" -ne 0 ]]; then
          handle_enospc "$tmp"
          if dc_log_is_port_conflict "$tmp"; then
            echo "dc-up: still blocked after stopping holders. Check compose host ports." >&2
          fi
          return "$rc"
        fi
      else
        return "$rc"
      fi
    else
      return "$rc"
    fi
  fi
  echo "dc-up: compose-kind $name (no dc-forward; official CLI unused)"
  dc_engine_up_line
  return 0
}

if [[ "$_up_kind" != "compose" ]] && ! command -v devcontainer >/dev/null 2>&1; then
  echo "devcontainer CLI not found. Advertised install:" >&2
  echo "  curl -fsSL https://raw.githubusercontent.com/Brasth/dc-cli/main/install.sh | bash -s -- --with-cli" >&2
  echo "or: bash install.sh --with-cli-npm" >&2
  echo "or: bash install.sh --with-cli" >&2
  exit 1
fi

# Prefer the labeled folder if a box already exists (symlink / Users vs Volumes).
ws="$(dc_cli_workspace_folder "$workspace")"
args=(up --workspace-folder "$ws")

if [[ -n "$override" ]]; then
  if [[ ! -f "$override" ]]; then
    echo "Override file missing: $override" >&2
    exit 1
  fi
  echo "WARNING: --override-config REPLACES project devcontainer.json (not a merge)." >&2
  args+=(--override-config "$override")
fi

run_up() {
  local tmp="$1"
  : >"$tmp"
  set +e
  devcontainer "${args[@]}" 2>&1 | tee "$tmp"
  local rc=${PIPESTATUS[0]}
  set -e
  return "$rc"
}

handle_enospc() {
  local tmp="$1"
  if grep -qiE 'no space left|ENOSPC|disk full|not enough disk|out of disk' "$tmp" 2>/dev/null; then
    echo >&2
    echo "dc-up: Docker looks out of disk. Check and reclaim:" >&2
    echo "  dc-df" >&2
    echo "  dc-prune          # dry-run" >&2
    echo "  dc-prune --yes    # safe: cache + dangling + orphan sidecars" >&2
    echo "  dc-prune --colima-hint   # if Colima VM is full after prune" >&2
  fi
}

# Show holders; optionally stop them. Returns 0 if user/agent chose to free ports.
resolve_port_conflict() {
  local tmp="$1"
  local -a ports_hit=()
  local -a holder_ids=()
  local p id name compose folder hports ans
  local line

  mapfile -t ports_hit < <(dc_ports_from_log "$tmp")
  if [[ ${#ports_hit[@]} -eq 0 ]]; then
    # fallback: any digits near "already allocated"
    mapfile -t ports_hit < <(grep -Eo '[0-9]{2,5}' "$tmp" 2>/dev/null | awk 'NF && !seen[$0]++' | head -n 5)
  fi

  echo >&2
  echo "dc-up: host port conflict (port already allocated)." >&2
  if [[ ${#ports_hit[@]} -gt 0 ]]; then
    echo "  ports: ${ports_hit[*]}" >&2
  fi
  echo "  holders:" >&2

  declare -A seen_id=()
  for p in "${ports_hit[@]+"${ports_hit[@]}"}"; do
    while IFS=$'\t' read -r id name compose folder hports; do
      [[ -n "$id" ]] || continue
      [[ -n "${seen_id[$id]:-}" ]] && continue
      seen_id[$id]=1
      holder_ids+=("$id")
      printf '    %s  %s' "${id:0:12}" "$name" >&2
      [[ -n "$compose" && "$compose" != "-" ]] && printf '  compose=%s' "$compose" >&2
      [[ -n "$folder" && "$folder" != "-" ]] && printf '  folder=%s' "$folder" >&2
      printf '\n      %s\n' "$hports" >&2
    done < <(dc_holders_of_host_port "$p")
  done

  if [[ ${#holder_ids[@]} -eq 0 ]]; then
    echo "    (no running container matched — another process or stale publish?)" >&2
    echo "  try: lsof -nP -iTCP:${ports_hit[0]:-PORT} -sTCP:LISTEN" >&2
    return 1
  fi

  # Do not stop containers that belong to *this* workspace (partial up).
  # Unattended mutate only positively identified foreign / reclaimable sidecars.
  local -a foreign=()
  local -a blocked=()
  local kind reason target_id target_ws
  for id in "${holder_ids[@]}"; do
    IFS='|' read -r kind reason folder compose target_id target_ws < <(dc_classify_port_holder "$id" "$ws")
    if [[ "$reason" == "same-workspace" ]]; then
      echo "  skip self  ${id:0:12}  (same workspace)" >&2
      continue
    fi
    case "$reason" in
      foreign|orphan-absent)
        foreign+=("$id")
        ;;
      *)
        blocked+=("$id")
        echo "  report-only  ${id:0:12}  reason=${reason:-unlabeled}" >&2
        ;;
    esac
  done

  if [[ ${#foreign[@]} -eq 0 ]]; then
    if [[ ${#blocked[@]} -gt 0 ]]; then
      echo "  no mutable foreign holders (unlabeled/ambiguous/unknown stay report-only)." >&2
    else
      echo "  only this workspace holds the ports — fix compose host ports in the project." >&2
    fi
    return 1
  fi

  ans="n"
  if [[ "$take_ports" -eq 1 || "$yes" -eq 1 || "${DC_UP_TAKE_PORTS:-}" == "1" ]]; then
    ans="y"
    echo "  --take-ports / --yes: stopping holders and retrying..." >&2
  elif [[ -t 0 && -t 1 ]]; then
    echo >&2
    printf 'Stop the holder(s) above and retry dc-up for this folder? [y/N] ' >&2
    read -r ans || ans="n"
  else
    echo >&2
    echo "  non-interactive: re-run with  dc-up --take-ports   to stop holders and retry." >&2
    echo "  or stop manually:  dc-down <other-workspace>   /   docker stop <name>" >&2
    return 1
  fi

  case "$ans" in
    y|Y|yes|YES) ;;
    *)
      echo "  aborted (ports left as-is)." >&2
      return 1
      ;;
  esac

  dc_with_mutation_lock _dc_up_stop_foreign "$ws" "${foreign[@]}"
  return 0
}

_dc_up_stop_foreign() {
  local current_ws="$1"
  shift
  local id
  for id in "$@"; do
    dc_stop_port_holder "$id" "$current_ws" || true
  done
}

# Create missing declared external nets before official CLI up.
ensure_declared_nets() {
  local name kind present creatable driver reason ans
  local -a miss_c=() miss_b=()
  while IFS='|' read -r name kind present creatable driver reason; do
    [[ -n "$name" ]] || continue
    if [[ "$present" != "1" && "$creatable" == "1" ]]; then
      miss_c+=("$name")
    elif [[ "$present" != "1" && "$reason" != "compose-managed" ]]; then
      miss_b+=("$name|$reason")
    fi
  done < <(dc_net_report_tsv "$ws")

  if [[ ${#miss_b[@]} -gt 0 ]]; then
    echo "dc-up: cannot create blocked network(s):" >&2
    for name in "${miss_b[@]}"; do
      echo "  ${name%%|*}  (${name#*|})" >&2
    done
    return 1
  fi
  if [[ ${#miss_c[@]} -eq 0 ]]; then
    return 0
  fi

  echo "dc-up: missing external network(s): ${miss_c[*]}" >&2
  ans="n"
  if [[ "$create_nets" -eq 1 || "$yes" -eq 1 || "${DC_UP_CREATE_NETS:-}" == "1" ]]; then
    ans="y"
    echo "  --create-nets / --yes: creating..." >&2
  elif [[ -t 0 && -t 1 ]]; then
    printf 'Create missing external network(s) as default bridge and continue dc-up? [y/N] ' >&2
    read -r ans || ans="n"
  else
    echo "  non-interactive: re-run with  dc-up --create-nets" >&2
    echo "  or:  dc-net --ensure --yes" >&2
    return 1
  fi
  case "$ans" in
    y|Y|yes|YES) ;;
    *)
      echo "  aborted (networks left as-is)." >&2
      return 1
      ;;
  esac
  dc_net_create_missing "$ws" >/dev/null || {
    echo "dc-up: network create failed" >&2
    return 1
  }
  return 0
}

if [[ "$_up_kind" == "compose" ]]; then
  dc_up_compose_kind "$_up_ws"
  exit $?
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

if ! ensure_declared_nets; then
  exit 1
fi

rc=0
run_up "$tmp" || rc=$?

if [[ "$rc" -ne 0 ]]; then
  handle_enospc "$tmp"
  if dc_log_is_port_conflict "$tmp"; then
    if resolve_port_conflict "$tmp"; then
      echo >&2
      echo "dc-up: retrying after freeing ports..." >&2
      rc=0
      run_up "$tmp" || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        handle_enospc "$tmp"
        if dc_log_is_port_conflict "$tmp"; then
          echo "dc-up: still blocked after stopping holders. Check compose host ports." >&2
        fi
        exit "$rc"
      fi
    else
      exit "$rc"
    fi
  else
    exit "$rc"
  fi
fi

if [[ "$no_forward" -eq 1 || "${DC_FORWARD:-1}" == "0" ]]; then
  echo "dc-up: skipped port forward (DC_FORWARD=0 / --no-forward)"
  dc_engine_up_line
  exit 0
fi

fwd="$(command -v dc-forward 2>/dev/null || true)"
if [[ -z "$fwd" && -x "$(dirname "$0")/dc-forward" ]]; then
  fwd="$(dirname "$0")/dc-forward"
fi
if [[ -n "$fwd" ]]; then
  echo "dc-up: publishing unpublished ports (dc-forward)..."
  if ! "$fwd" "$ws"; then
    echo "dc-up: container ready, forwarding incomplete" >&2
    exit 1
  fi
else
  echo "dc-up: dc-forward not on PATH; host browser may not reach the app" >&2
fi
dc_engine_up_line
