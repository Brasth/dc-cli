#!/usr/bin/env bash
# dc — one entry. Verbs map to dc-<verb>. No args opens the board.
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"

dc_exec() {
  local name="$1"
  shift
  local bin="$_here/$name"
  if [[ ! -x "$bin" ]]; then
    echo "dc: missing $name (expected next to $0)" >&2
    exit 1
  fi
  exec "$bin" "$@"
}

usage() {
  cat <<'EOF'
dc — this folder. Two spellings, same command.

  dc / dc-tui                    clickable board
  dc up / dc-up                  start
  dc exec / dc-exec              shell in the app
  dc down / dc-down              stop the stack
  dc doctor / dc-doctor          read-only diagnose
  dc inspect / dc-inspect        read-only snapshot
  dc recover / dc-recover        one next step (--yes applies)
  dc upgrade / dc-upgrade        check / install latest release
  dc try / dc-try                sandbox when there is no config

  dc exec --service NAME
  dc --all                       fleet board
  dc --help

`dc <verb>` execs `dc-<verb>`. Both stay installed.
EOF
}

is_verb() {
  case "$1" in
    tui|doctor|inspect|recover|engine|upgrade|up|try|exec|down|ls|open|db|files|forward|ps|df|stats|net|prune)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if [[ $# -eq 0 ]]; then
  dc_exec dc-tui
fi

case "$1" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

if is_verb "$1"; then
  verb="$1"
  shift
  dc_exec "dc-${verb}" "$@"
fi

if [[ "$1" == -* || -d "$1" || "$1" == /* || "$1" == .* ]]; then
  dc_exec dc-tui "$@"
fi

echo "dc: unknown verb '$1'" >&2
echo "Try dc --help. Hyphenated names still work (dc-up, dc-exec, …)." >&2
exit 2
