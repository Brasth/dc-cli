#!/usr/bin/env bash
# Exec into the workspace app container, or another compose service.
# Usage:
#   dc-exec                         # bash in the labeled app (devcontainer exec)
#   dc-exec -- ls -la
#   dc-exec --service db            # docker exec into compose service
#   dc-exec db                      # same if ./db is not a directory
#   dc-exec --id NAME_OR_ID
#   dc-exec --service NAME --restart
#   dc-exec --list [workspace]
set -euo pipefail

_here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$_here/../lib/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-common.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-common.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-common.sh"
else
  echo "dc-common.sh not found (install.sh copies it to ~/.config/devcontainer/)" >&2
  exit 1
fi
if [[ -f "$_here/../lib/dc-net.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_here/../lib/dc-net.sh"
elif [[ -f "${HOME}/.config/devcontainer/dc-net.sh" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.config/devcontainer/dc-net.sh"
fi

workspace="."
service=""
explicit_id=""
do_list=0
do_restart=0
json=0
cmd=()

usage() {
  cat <<'EOF'
dc-exec — shell into the app container, or another service in the same compose stack

  dc-exec [workspace]                 bash in the labeled app (devcontainer exec)
  dc-exec [workspace] -- cmd...
  dc-exec --service NAME [workspace]  docker exec into that compose service
  dc-exec --service NAME --restart    docker restart that stack sibling
  dc-exec NAME                        same, if ./NAME is not a directory
  dc-exec --id NAME_OR_ID [-- cmd]
  dc-exec --list [workspace]          show the compose stack
  dc-exec --list --json [workspace]
  dc-exec --help

Other services share com.docker.compose.project with the labeled app.
Sidecars from dc-forward are omitted. Default shell is bash, then sh.
A stopped service is docker-started first, then exec.
--restart is stack-membership only. --id --restart is refused.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --service|-s)
      shift
      [[ $# -ge 1 ]] || { echo "--service needs a name" >&2; exit 2; }
      service="$1"
      ;;
    --id)
      shift
      [[ $# -ge 1 ]] || { echo "--id needs a container" >&2; exit 2; }
      explicit_id="$1"
      ;;
    --list) do_list=1 ;;
    --restart) do_restart=1 ;;
    --json) json=1 ;;
    --version|-V) dc_cli_print_version "$(basename "$0")"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --)
      shift
      cmd+=("$@")
      break
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -d "$1" ]]; then
        workspace="$1"
      elif [[ -z "$service" && -z "$explicit_id" ]]; then
        service="$1"
      else
        echo "Unknown arg: $1" >&2
        exit 2
      fi
      ;;
  esac
  shift
done

if [[ "$do_restart" -eq 1 ]]; then
  if [[ -n "$explicit_id" ]]; then
    echo "dc-exec: --id --restart is not allowed (restart is stack-only). Use --service NAME --restart." >&2
    exit 2
  fi
  if [[ -z "$service" ]]; then
    echo "dc-exec: --restart requires --service NAME" >&2
    usage >&2
    exit 2
  fi
  dc_restart_in_stack "$workspace" "$service" || exit 1
  exit 0
fi

if [[ "$do_list" -eq 1 ]]; then
  if [[ "$json" -eq 1 ]]; then
    dc_stack_json "$workspace"
    exit 0
  fi
  printf '%-12s  %-10s  %-28s  %s\n' "STATUS" "SERVICE" "NAME" "ID"
  while IFS=$'\t' read -r id name status svc image; do
    [[ -n "$id" ]] || continue
    printf '%-12s  %-10s  %-28s  %s\n' "$status" "${svc:--}" "$name" "${id:0:12}"
  done < <(dc_stack_rows "$workspace")
  exit 0
fi

dc_exec_color_rc() {
  if [[ -f "$_here/../lib/dc-exec-color.sh" ]]; then
    printf '%s\n' "$_here/../lib/dc-exec-color.sh"
    return 0
  fi
  return 1
}

dc_inject_color_rc() {
  local id="$1" src
  src="$(dc_exec_color_rc)" || return 1
  docker cp "$src" "$id:/tmp/dc-cli.bashrc" >/dev/null 2>&1
}

docker_exec() {
  local id="$1"
  shift
  local flags=(-i)
  # -t only when both ends are a TTY. Agents / pipes die with
  # "the input device is not a TTY" if we always pass -it.
  if [[ -t 0 && -t 1 ]]; then
    flags=(-it)
  fi
  flags+=(
    -e "TERM=${TERM:-xterm-256color}"
    -e "COLORTERM=${COLORTERM:-truecolor}"
    -e "CLICOLOR=1"
    -e "FORCE_COLOR=1"
  )
  exec docker exec "${flags[@]}" "$id" "$@"
}

docker_shell() {
  local id="$1"
  shift
  if [[ $# -gt 0 ]]; then
    docker_exec "$id" "$@"
  fi
  dc_inject_color_rc "$id" || true
  if docker exec "$id" bash -lc 'exit 0' >/dev/null 2>&1; then
    if docker exec "$id" test -f /tmp/dc-cli.bashrc >/dev/null 2>&1; then
      docker_exec "$id" bash --rcfile /tmp/dc-cli.bashrc
    fi
    docker_exec "$id" bash
  fi
  docker_exec "$id" sh
}

if [[ -n "$explicit_id" ]]; then
  if ! docker inspect "$explicit_id" >/dev/null 2>&1; then
    echo "Container not found: $explicit_id" >&2
    exit 1
  fi
  dc_ensure_running "$explicit_id" || exit 1
  docker_shell "$explicit_id" "${cmd[@]+"${cmd[@]}"}"
fi

if [[ -n "$service" ]]; then
  row=""
  row="$(dc_stack_resolve "$workspace" "$service")" || {
    echo "No compose service \"$service\" in this workspace stack. Try: dc-exec --list" >&2
    exit 1
  }
  IFS=$'\t' read -r id name status svc image <<<"$row"
  if [[ -z "$id" ]]; then
    echo "No compose service \"$service\" in this workspace stack. Try: dc-exec --list" >&2
    exit 1
  fi
  echo "exec  ${svc:-$name}  $name  ${id:0:12}"
  dc_ensure_running "$id" || exit 1
  docker_shell "$id" "${cmd[@]+"${cmd[@]}"}"
fi

if [[ "$(dc_workspace_kind "$workspace")" == "compose" ]]; then
  _exec_svc=""
  _exec_svc="$(dc_compose_app_service "$workspace")" || {
    echo "dc-exec: ambiguous compose app service. Use --list then --service NAME." >&2
    exit 1
  }
  _exec_name="$(dc_compose_project_name "$workspace")" || {
    echo "dc-exec: cannot resolve compose project name" >&2
    exit 1
  }
  _exec_args=()
  while IFS= read -r _f; do
    [[ -n "$_f" ]] || continue
    _exec_args+=(-f "$_f")
  done < <(dc_compose_file_args "$workspace")
  echo "exec  ${_exec_svc}  (compose-kind)"
  (cd "$workspace" && dc_docker_compose -p "$_exec_name" "${_exec_args[@]+"${_exec_args[@]}"}" start "$_exec_svc") >/dev/null 2>&1 || true
  _exec_flags=()
  if [[ -t 0 && -t 1 ]]; then
    _exec_flags+=(-it)
  else
    _exec_flags+=(-T)
  fi
  if [[ ${#cmd[@]} -eq 0 ]]; then
    if dc_docker_compose -p "$_exec_name" "${_exec_args[@]+"${_exec_args[@]}"}" exec -T "$_exec_svc" bash -lc 'exit 0' >/dev/null 2>&1; then
      dc_docker_compose_exec -p "$_exec_name" "${_exec_args[@]+"${_exec_args[@]}"}" exec "${_exec_flags[@]+"${_exec_flags[@]}"}" "$_exec_svc" bash
    fi
    dc_docker_compose_exec -p "$_exec_name" "${_exec_args[@]+"${_exec_args[@]}"}" exec "${_exec_flags[@]+"${_exec_flags[@]}"}" "$_exec_svc" sh
  fi
  dc_docker_compose_exec -p "$_exec_name" "${_exec_args[@]+"${_exec_args[@]}"}" exec "${_exec_flags[@]+"${_exec_flags[@]}"}" "$_exec_svc" "${cmd[@]}"
fi

# Default: official CLI into the labeled app (features, remoteUser, cwd).
# Must pass the exact label string — `.` / symlink realpath miss the box.
ws="$(dc_cli_workspace_folder "$workspace")"
app_id="$(dc_ids_for_workspace "$workspace" | head -n1)"
if [[ -n "$app_id" ]]; then
  dc_ensure_running "$app_id" || exit 1
  if [[ ${#cmd[@]} -eq 0 ]]; then
    dc_inject_color_rc "$app_id" || true
  fi
fi
if [[ ${#cmd[@]} -eq 0 ]]; then
  if [[ -n "$app_id" ]] && docker exec "$app_id" test -f /tmp/dc-cli.bashrc >/dev/null 2>&1; then
    exec devcontainer exec --workspace-folder "$ws" \
      --remote-env "TERM=${TERM:-xterm-256color}" \
      --remote-env "COLORTERM=${COLORTERM:-truecolor}" \
      bash --rcfile /tmp/dc-cli.bashrc
  fi
  exec devcontainer exec --workspace-folder "$ws" \
    --remote-env "TERM=${TERM:-xterm-256color}" \
    --remote-env "COLORTERM=${COLORTERM:-truecolor}" \
    bash
fi
exec devcontainer exec --workspace-folder "$ws" \
  --remote-env "TERM=${TERM:-xterm-256color}" \
  --remote-env "COLORTERM=${COLORTERM:-truecolor}" \
  "${cmd[@]}"
