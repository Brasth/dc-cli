---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { breadcrumbs, siteUrl } from '../../lib/schema';

const order = ['install', 'tui', 'doctor', 'ports', 'disk'];
const guides = await getCollection('guides');
const cards = order
  .map((id) => guides.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof guides)[number] => Boolean(entry));

const schema = [
  breadcrumbs([
    { name: 'dc-cli', path: '/' },
    { name: 'Guides', path: '/guide/' },
  ]),
  {
    '@type': 'ItemList',
    name: 'dc-cli guides',
    itemListElement: cards.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(`/guide/${entry.id}/`, siteUrl).href,
    })),
  },
];
---

<Page
  title="Guides — dc-cli"
  description="Task guides for dc-cli: install, dc-tui keys, dc-doctor, Colima ports, and disk full. Command flags stay in the README."
  path="/guide/"
  schema={schema}
>
  <section class="px-4 pb-16 pt-20 md:px-6 md:pb-20 md:pt-24">
    <div class="mx-auto w-full max-w-6xl">
      <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">guide / tasks</p>
      <h1 class="mt-3 max-w-3xl font-mono text-4xl leading-[0.95] tracking-tight md:text-6xl">
        Five jobs. Not a second README.
      </h1>
      <p class="mt-5 max-w-xl text-sm text-mute">
        Install, the board, doctor, ports, disk. Full flag tables stay on
        <a class="text-ink/80 hover:text-ink" href="https://github.com/Brasth/dc-cli#commands-all-of-them">GitHub</a>.
      </p>
      <ol class="mt-12 grid gap-px bg-ink/10 sm:grid-cols-2">
        {
          cards.map((entry) => (
            <li class="bg-page p-6 md:p-8">
              <p class="font-mono text-[11px] text-amber">/{entry.id}</p>
              <h2 class="mt-3 font-mono text-2xl tracking-tight">
                <a href={`/guide/${entry.id}/`} class="hover:text-amber">
                  {entry.data.title}
                </a>
              </h2>
              <p class="mt-3 text-sm text-mute">{entry.data.description}</p>
              <a
                href={`/guide/${entry.id}/`}
                class="mt-6 inline-flex min-h-10 items-center font-mono text-xs text-ink/80 hover:text-ink"
              >
                open →
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Page>
