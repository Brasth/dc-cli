---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { breadcrumbs, siteUrl } from '../../lib/schema';

const order = ['install', 'try', 'tui', 'stuck', 'kind', 'doctor', 'no-docker', 'ports', 'disk'];
const guides = await getCollection('guides');
const cards = order
  .map((id) => guides.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof guides)[number] => Boolean(entry));

const schema = [
  breadcrumbs([
    { name: 'dc-cli', path: '/' },
    { name: 'Guides', path: '/guide/' },
  ]),
  {
    '@type': 'ItemList',
    name: 'dc-cli guides',
    itemListElement: cards.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.data.title,
      url: new URL(`/guide/${entry.id}/`, siteUrl).href,
    })),
  },
];
---

<Page
  title="Guides — dc-cli"
  description="Task guides for dc-cli: install, board keys, doctor, ports, and disk. Type dc, then a verb. dc-up still works. Flags: dc --help."
  path="/guide/"
  schema={schema}
>
  <section class="page-container pb-20 pt-12 md:pb-28 md:pt-20">
    <p class="prompt"><span>~</span><span class="sigil">$</span><span class="cmd-text">dc --help</span></p>
    <h1 class="t-display mt-5 max-w-[16ch] !text-[clamp(2.5rem,1.6rem+3.6vw,4.5rem)]">Task guides. README stays short.</h1>
    <p class="t-lede mt-6 max-w-[38rem]">
      Install, kind, board, doctor, missing Docker, ports, disk, sandbox try. Type
      <span class="cmd">dc</span>, then a verb. <span class="cmd">dc-up</span> still works. Flags:
      <span class="cmd">dc --help</span>.
    </p>
    <ol class="mt-12 border-b border-line md:mt-16">
      {
        cards.map((entry) => (
          <li class="group relative grid gap-2 border-t border-line py-6 md:grid-cols-12 md:items-baseline md:gap-8">
            <p class="font-mono text-[12px] text-accent md:col-span-2">/{entry.id}</p>
            <div class="md:col-span-8">
              <h2 class="t-h3">
                <a href={`/guide/${entry.id}/`} class="after:absolute after:inset-0 group-hover:text-accent">
                  {entry.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-6 text-muted">{entry.data.description}</p>
            </div>
            <span class="hidden font-mono text-xs text-soft group-hover:text-fg md:col-span-2 md:block md:justify-self-end" aria-hidden="true">
              open →
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</Page>
