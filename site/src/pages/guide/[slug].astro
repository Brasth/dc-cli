---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { breadcrumbs, faqPage, howTo } from '../../lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/guide/${entry.id}/`;
const pageTitle = /dc-cli/i.test(entry.data.title)
  ? entry.data.title
  : `${entry.data.title} — dc-cli`;
const crumbs = breadcrumbs([
  { name: 'dc-cli', path: '/' },
  { name: 'Guides', path: '/guide/' },
  { name: entry.data.title, path },
]);
const schema = [
  crumbs,
  ...(entry.data.howto && entry.data.steps ? [howTo(entry.data.title, entry.data.steps)] : []),
  ...(entry.data.faq?.length ? [faqPage(entry.data.faq)] : []),
];

const siblings = [
  { id: 'install', label: 'install' },
  { id: 'tui', label: 'tui' },
  { id: 'doctor', label: 'doctor' },
  { id: 'ports', label: 'ports' },
  { id: 'disk', label: 'disk' },
];
---

<Page title={pageTitle} description={entry.data.description} path={path} schema={schema}>
  <article class="page-container pb-20 pt-10 md:pb-28 md:pt-16">
    <div class="mx-auto w-full max-w-3xl">
      <nav class="font-mono text-[12px] text-muted" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center">
          <li><a class="inline-flex min-h-11 items-center hover:text-fg" href="/">dc-cli</a></li>
          <li aria-hidden="true" class="px-2">/</li>
          <li><a class="inline-flex min-h-11 items-center hover:text-fg" href="/guide/">guide</a></li>
          <li aria-hidden="true" class="px-2">/</li>
          <li><span class="text-fg" aria-current="page">{entry.id}</span></li>
        </ol>
      </nav>
      <p class="mt-6 font-mono text-[12px] text-muted">
        updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{entry.data.updated.toISOString().slice(0, 10)}</time>
      </p>
      <h1 class="t-h2 mt-3">
        {entry.data.h1}
      </h1>
      <p class="t-lede mt-5">{entry.data.description}</p>
      <div class="guide-prose mt-10">
        <Content />
      </div>
      {
        entry.data.faq?.length ? (
          <section class="mt-16 border-t border-line pt-10" aria-labelledby="faq-title">
            <h2 id="faq-title" class="t-h3">FAQ</h2>
            <dl class="mt-6 divide-y divide-line border-y border-line">
              {entry.data.faq.map((item) => (
                <div class="py-5">
                  <dt class="font-medium text-fg">{item.q}</dt>
                  <dd class="mt-2 text-[15px] leading-7 text-soft">{item.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        ) : null
      }
      <p class="mt-12 font-mono text-xs text-muted">
        Broke something?
        <a class="link" href="/issues/">report it</a>
      </p>
      <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-1 border-t border-line pt-4 font-mono text-xs" aria-label="Other guides">
        {
          siblings.map((item) =>
            item.id === entry.id ? (
              <span class="inline-flex min-h-11 items-center text-accent" aria-current="page">{item.label}</span>
            ) : (
              <a class="inline-flex min-h-11 items-center text-soft hover:text-fg" href={`/guide/${item.id}/`}>
                {item.label}
              </a>
            ),
          )
        }
      </nav>
    </div>
  </article>
</Page>

<style>
  .guide-prose :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: var(--tracking-h3);
    line-height: 1.2;
    color: var(--fg);
  }
  .guide-prose :global(h3) {
    margin-top: 2rem;
    font-size: var(--text-h3);
    font-weight: 560;
    color: var(--fg);
  }
  .guide-prose :global(p),
  .guide-prose :global(li) {
    color: var(--fg-soft);
    font-size: 1rem;
    line-height: 1.75;
  }
  .guide-prose :global(p + p),
  .guide-prose :global(h2 + p),
  .guide-prose :global(h3 + p) {
    margin-top: 1rem;
  }
  .guide-prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .guide-prose :global(ul),
  .guide-prose :global(ol) {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }
  .guide-prose :global(ul) {
    list-style: square;
  }
  .guide-prose :global(ul li::marker) {
    color: var(--accent);
  }
  .guide-prose :global(ol) {
    list-style: decimal;
  }
  .guide-prose :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 0.2em;
  }
  .guide-prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }
  .guide-prose :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--raised);
    font-family: var(--font-code);
    font-size: 0.85em;
    color: var(--fg);
  }
  .guide-prose :global(pre) {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--sunken) !important;
    padding: 1rem 1.25rem;
    font-family: var(--font-code);
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .guide-prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }
  .guide-prose :global(table) {
    display: block;
    width: 100%;
    margin: 1.5rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .guide-prose :global(th),
  .guide-prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 0.65rem 1rem 0.65rem 0;
    text-align: left;
    vertical-align: top;
    color: var(--fg-soft);
  }
  .guide-prose :global(th) {
    font-family: var(--font-code);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom-color: var(--line-strong);
  }
  .guide-prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
  }
</style>
