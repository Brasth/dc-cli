---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Board from '../components/Board.astro';
import CopyButton from '../components/CopyButton.astro';
---

<Layout
  title="Play the dc-tui board — dc-cli"
  description="Try every dc-tui key in the browser. Same board as dc. Start, shell, logs, top, nets, rm confirm."
  path="/play/"
>
  <main id="main" class="relative z-10 min-h-[100dvh] pb-12 pt-5 md:pt-8">
    <div class="page-container">
      <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 font-mono text-xs">
          <a href="/" class="inline-flex min-h-11 items-center gap-2 text-fg hover:text-accent">
            <Logo class="h-5 w-5" />
            <span>dc-cli</span>
          </a>
          <span class="text-muted" aria-hidden="true">/</span>
          <span class="text-soft" aria-current="page">play</span>
        </nav>
        <p class="font-mono text-[12px] text-muted">
          click a key or type it · <kbd class="kbd">u</kbd> then <kbd class="kbd">y</kbd> starts a sandbox ·
          <kbd class="kbd">q</kbd> never leaves this page
        </p>
      </header>

      <h1 class="sr-only">Play the dc-tui board</h1>

      <div class="mt-5">
        <Board demo="none" keys="window" />
      </div>

      <footer class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
        <CopyButton id="play-copy-install" statusId="play-copy-status" trackSource="play" />
        <p class="font-mono text-[12px] text-muted">
          Install for the real folder, then <span class="text-fg">source</span> + <span class="text-fg">dc try</span>.
        </p>
        <a href="/guide/tui/" class="btn btn-ghost">Board guide <span aria-hidden="true">→</span></a>
        <p id="play-copy-status" class="min-h-5 w-full font-mono text-[12px] text-accent" aria-live="polite"></p>
      </footer>
    </div>
  </main>
</Layout>
