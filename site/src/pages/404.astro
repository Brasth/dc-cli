---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — dc-cli"
  description="This path is not on dc.brasth.com."
  noindex={true}
>
  <main class="relative z-10 mx-auto flex min-h-[100dvh] w-full max-w-6xl flex-col justify-center px-4">
    <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">not found</p>
    <h1 class="mt-3 font-mono text-4xl tracking-tight">This path is not in the stack.</h1>
    <p class="mt-4 max-w-md text-mute">No container, no page. Back to the board.</p>
    <a
      href="/"
      class="mt-8 inline-flex w-max min-h-10 items-center bg-ink px-4 font-mono text-xs text-page"
    >
      $ cd ~
    </a>
  </main>
</Layout>
