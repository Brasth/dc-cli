---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — dc-cli" description="This path is not on dc.brasth.com." noindex={true}>
  <main id="main" class="page-container relative z-10 flex min-h-[100dvh] flex-col justify-center">
    <p class="prompt"><span>~</span><span class="sigil">$</span><span class="cmd-text">cd <span id="nf-path">this-path</span></span></p>
    <p class="mt-2 font-mono text-[12px] text-danger">no such file or directory</p>
    <h1 class="t-h2 mt-6 max-w-[18ch]">This path is not in the stack.</h1>
    <p class="t-body mt-4 max-w-md">No container, no page. Back to the board.</p>
    <div class="mt-8 flex flex-wrap gap-2">
      <a href="/" class="btn btn-solid">$ cd ~</a>
      <a href="/guide/" class="btn btn-outline">Guides</a>
      <a href="/play/" data-track-source="404" class="btn btn-ghost">Play</a>
    </div>
  </main>
  <script>
    const el = document.getElementById('nf-path');
    if (el) el.textContent = window.location.pathname;
  </script>
</Layout>
