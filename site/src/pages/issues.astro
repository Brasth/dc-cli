---
import Page from '../layouts/Page.astro';
import { breadcrumbs } from '../lib/schema';

const bug = 'https://github.com/Brasth/dc-cli/issues/new?template=bug.yml';
const question = 'https://github.com/Brasth/dc-cli/issues/new?template=question.yml';
const feedback = 'https://github.com/Brasth/dc-cli/issues/new?template=feedback.yml';
const list = 'https://github.com/Brasth/dc-cli/issues';

const schema = [
  breadcrumbs([
    { name: 'dc-cli', path: '/' },
    { name: 'Issues', path: '/issues/' },
  ]),
  {
    '@type': 'WebPage',
    name: 'Report a dc-cli issue',
    description: 'File a bug, question, or activation feedback on GitHub. Include the command, OS, and Docker backend.',
    url: 'https://dc.brasth.com/issues/',
  },
];
---

<Page
  title="Report a dc-cli issue"
  description="File a dc-cli bug or question on GitHub. Include the command, OS, and Colima vs Docker Desktop. No secrets."
  path="/issues/"
  schema={schema}
>
  <section class="page-container pb-20 pt-12 md:pb-28 md:pt-20">
    <div class="w-full max-w-4xl">
      <p class="prompt"><span>~</span><span class="sigil">$</span><span class="cmd-text">dc recover --report</span></p>
      <h1 class="t-h2 mt-4 max-w-[18ch]">
        Report a break. Not a ticket form.
      </h1>
      <p class="t-body mt-5 max-w-xl">
        GitHub is the tracker. This page only aims you. Read
        <a class="link" href="/guide/">the guides</a>
        first if it is install, kind, doctor, stuck, ports, or disk. Include <span class="cmd">dc-recover --report</span> or <span class="cmd">dc-doctor --json</span> when you can.
      </p>
      <div class="mt-10 grid border-y border-line sm:grid-cols-3">
        <a class="issue-card group border-line p-6 transition-colors duration-[var(--dur-base)] hover:bg-surface" href={bug}>
          <p class="font-mono text-[12px] text-accent">template / bug</p>
          <h2 class="t-h3 mt-3 group-hover:text-accent">It broke</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Command, OS, Colima vs Desktop, paste the error. No <span class="cmd">.env</span>.</p>
        </a>
        <a class="issue-card group border-line p-6 transition-colors duration-[var(--dur-base)] hover:bg-surface" href={question}>
          <p class="font-mono text-[12px] text-accent">template / question</p>
          <h2 class="t-h3 mt-3 group-hover:text-accent">I am stuck</h2>
          <p class="mt-2 text-sm leading-6 text-muted">What you ran. What you expected. What you already tried.</p>
        </a>
        <a class="issue-card group border-line p-6 transition-colors duration-[var(--dur-base)] hover:bg-surface" href={feedback}>
          <p class="font-mono text-[12px] text-accent">template / feedback</p>
          <h2 class="t-h3 mt-3 group-hover:text-accent">Got a shell?</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Activation feedback — yes, no, or still trying.</p>
        </a>
      </div>
      <ul class="mt-10 space-y-2 font-mono text-xs leading-5 text-muted">
        <li><span class="text-accent" aria-hidden="true">▸</span> paste a <span class="cmd">dc recover --report</span> folder, <span class="cmd">dc df</span>, or the <span class="cmd">dc up</span> holder list</li>
        <li><span class="text-accent" aria-hidden="true">▸</span> never paste tokens, <span class="cmd">.env</span>, or <span class="cmd">docker inspect</span> dumps</li>
        <li>
          <span class="text-accent" aria-hidden="true">▸</span>
          open list:
          <a class="link" href={list}>github.com/Brasth/dc-cli/issues</a>
        </li>
      </ul>
    </div>
  </section>
</Page>

<style>
  .issue-card + .issue-card {
    border-top-width: 1px;
  }
  @media (min-width: 640px) {
    .issue-card + .issue-card {
      border-top-width: 0;
      border-left-width: 1px;
    }
  }
</style>
