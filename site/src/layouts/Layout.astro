---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? 'dc-cli — host-global Dev Containers helpers';
const description =
  Astro.props.description ??
  'Start, exec, stop, ports, and disk for official @devcontainers/cli. No VS Code required. Does not edit project .devcontainer.';
const canonical = 'https://dc.brasth.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-page text-ink antialiased">
    <div class="cols" aria-hidden="true"></div>
    <div class="scan" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
