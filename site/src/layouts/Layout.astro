---
import '../styles/global.css';
import { cloudflareBeaconToken } from '../lib/analytics';
import { latestRelease } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const title = Astro.props.title ?? 'dc-cli — Dev containers from your terminal';
const description =
  Astro.props.description ??
  'Daily workspace hub: recent folders, pinned actions, session activity. dc up starts this folder. No config? dc try. No VS Code required. Never edits project .devcontainer.';
const noindex = Astro.props.noindex ?? false;
const site = 'https://dc.brasth.com';
const rawPath = Astro.props.path ?? Astro.url.pathname;
const path = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonical = new URL(path, site).href;
const ogImage = `${site}/og.png`;
const isHome = path === '/';
const cfBeacon = cloudflareBeaconToken();

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'dc-cli',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  license: 'https://opensource.org/licenses/MIT',
  url: `${site}/`,
  downloadUrl: 'https://raw.githubusercontent.com/Brasth/dc-cli/main/install.sh',
  codeRepository: 'https://github.com/Brasth/dc-cli',
  description,
  author: {
    '@type': 'Person',
    name: 'Huy Nguyen',
    url: 'https://github.com/Canvilled',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Brasth',
    url: 'https://github.com/Brasth',
  },
  softwareVersion: latestRelease,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const extras = Astro.props.schema ?? [];
const graph = [...(isHome ? [softwareApplication] : []), ...extras];
const jsonLd =
  graph.length > 0
    ? {
        '@context': 'https://schema.org',
        '@graph': graph,
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070806" />
    <meta name="author" content="Brasth" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:site_name" content="dc-cli" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dc-cli — the missing verbs for this folder" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="dc-cli — the missing verbs for this folder" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="texture-cols" aria-hidden="true"></div>
    <div class="texture-grain" aria-hidden="true"></div>
    <slot />
    <p id="copy-live" class="sr-only-live" aria-live="polite"></p>
    <script>
      /*
       * Shared copy handler. Any element with [data-install-copy] copies its
       * [data-install-cmd]. Feedback: the button label (or its [data-copy-label]
       * child) flips to "Copied", [data-copied] styles it, and the status element
       * named by [data-copy-status] (or the shared sr-only live region) announces it.
       */
      const RESET_MS = 1800;
      const timers = new WeakMap<HTMLElement, number>();

      async function writeText(text: string) {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        if (!ok) throw new Error('copy failed');
      }

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest<HTMLElement>('[data-install-copy]');
        if (!btn) return;
        const cmd = btn.getAttribute('data-install-cmd') ?? '';
        if (!cmd) return;
        const label = btn.querySelector<HTMLElement>('[data-copy-label]') ?? btn;
        if (!label.dataset.idle) label.dataset.idle = label.textContent?.trim() || 'Copy install';
        const statusId = btn.getAttribute('data-copy-status');
        const status = (statusId && document.getElementById(statusId)) || document.getElementById('copy-live');
        const message = btn.getAttribute('data-copy-message') ?? 'Copied. Paste it in your terminal.';
        try {
          await writeText(cmd);
          label.textContent = 'Copied';
          btn.dataset.copied = 'true';
          if (status) status.textContent = message;
          window.clearTimeout(timers.get(btn));
          timers.set(
            btn,
            window.setTimeout(() => {
              label.textContent = label.dataset.idle ?? 'Copy install';
              delete btn.dataset.copied;
              // The visible status stays a little longer than the button state.
              window.setTimeout(() => {
                if (status && status.textContent === message) status.textContent = '';
              }, 2400);
            }, RESET_MS),
          );
        } catch {
          window.location.assign('/#install');
        }
      });

      // Scroll reveal. Content is visible by default; .js opts in.
      const reveal = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && reveal.length) {
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-in'));
      }
    </script>
    {cfBeacon && (
      <script
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeacon })}
      />
    )}
  </body>
</html>
