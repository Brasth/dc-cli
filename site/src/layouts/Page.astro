---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
---

<Layout {...Astro.props}>
  <Nav />
  <main id="main" class="relative z-10 w-full overflow-x-clip pt-[var(--nav-h)]">
    <slot />
  </main>
  <Footer />
</Layout>
