---
const tiles = [
  {
    k: 'dc-up',
    title: 'Start the labeled app.',
    body: 'Reads project config, brings the stack up, publishes ports. Clash? It names the holder.',
    lines: ['$ dc-up', '→ labeled app up', '→ dc-forward :3000', 'ok  ports published'],
  },
  {
    k: 'dc-exec',
    title: 'Never docker exec.',
    body: 'App shell via official CLI. Other services: --service NAME. Stopped boxes start first.',
    lines: ['$ dc-exec --service db', '→ start db (was exited)', '→ docker exec skipped', 'root@db:/#'],
  },
  {
    k: 'dc-forward',
    title: 'Colima-safe ports.',
    body: 'Sidecar on the Docker network. Host socat to 172.x does not work on Colima.',
    lines: ['$ dc-forward 3000', '→ sidecar alpine/socat', '→ host :3000 → app', 'status  listening'],
  },
  {
    k: 'dc-prune',
    title: 'Disk without nuking DBs.',
    body: 'dc-df then dc-prune --yes. Never docker system prune -af --volumes.',
    lines: ['$ dc-df', 'docker  42%   colima  61%', '$ dc-prune --yes', 'reclaim  cache + dangling'],
  },
];
---

<section class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto w-full max-w-6xl">
    <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">the missing verbs</p>
    <div class="mt-4 grid grid-cols-1 overflow-hidden rounded-sm border border-ink/15 md:grid-cols-2">
      {
        tiles.map((tile) => (
          <article class="flex flex-col gap-4 border-ink/10 bg-core p-5 md:border-r md:border-b md:[&:nth-child(2n)]:border-r-0 md:[&:nth-last-child(-n+2)]:border-b-0">
            <p class="font-mono text-[11px] text-amber">{tile.k}</p>
            <pre class="font-mono text-[11px] leading-5 text-ink/70">
              {tile.lines.map((line) => (
                <span class:list={['block', line.startsWith('$') && 'text-ink', line.startsWith('→') && 'text-mute']}>
                  {line}
                </span>
              ))}
            </pre>
            <div>
              <h2 class="text-xl leading-tight tracking-tight text-ink">{tile.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-mute">{tile.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
