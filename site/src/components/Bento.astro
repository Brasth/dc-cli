---
const tiles = [
  {
    k: 'w',
    title: 'Workspaces.',
    body: 'Favorites first, then the latest 30 folders this board opened, including stopped projects. Opening one does not start it. The list works while Docker is down.',
    lines: ['$ dc', 'w', 'ctrl+f favorite', 'ctrl+d forget'],
  },
  {
    k: 'c',
    title: 'Pinned actions.',
    body: 'Opt-in and container-only. Shared .dc/actions.json stays off until you trust its exact bytes. A run uses dc exec --no-start, so nothing is started. Actions can change data inside the container.',
    lines: ['$ dc actions list', '$ dc actions run test', '$ dc exec --no-start -- go test ./...'],
  },
  {
    k: 'v',
    title: 'Session activity.',
    body: 'Latest 200 container events for this folder, kept in memory for this session. Accepted events refresh the board. Nothing is written to disk.',
    lines: ['$ dc', 'v'],
  },
];
---

<section class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto w-full max-w-6xl">
    <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">daily board</p>
    <div class="mt-4 grid grid-cols-1 overflow-hidden rounded-sm border border-ink/15 md:grid-cols-3">
      {
        tiles.map((tile) => (
          <article class="flex flex-col gap-4 border-ink/10 bg-core p-5 md:border-r md:[&:last-child]:border-r-0">
            <p class="font-mono text-[11px] text-amber">{tile.k}</p>
            <pre class="font-mono text-[11px] leading-5 text-ink/70">
              {tile.lines.map((line) => (
                <span class:list={['block', line.startsWith('$') && 'text-ink', line.startsWith('→') && 'text-mute']}>
                  {line}
                </span>
              ))}
            </pre>
            <div>
              <h2 class="text-xl leading-tight tracking-tight text-ink">{tile.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-mute">{tile.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
