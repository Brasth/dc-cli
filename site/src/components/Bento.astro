---
const tiles = [
  {
    k: 'dc-up',
    title: 'Start the labeled app.',
    body: 'Reads project config, brings the stack up, publishes ports. Clash? It names the holder. --take-ports stops the foreign stack and retries once.',
  },
  {
    k: 'dc-exec',
    title: 'Never docker exec.',
    body: 'App shell via official CLI. Other services: --service NAME. Stopped boxes start first.',
  },
  {
    k: 'dc-forward',
    title: 'Colima-safe ports.',
    body: 'Sidecar on the Docker network. Host socat to 172.x does not work on Colima.',
  },
  {
    k: 'dc-prune',
    title: 'Disk without nuking DBs.',
    body: 'dc-df then dc-prune --yes. Never docker system prune -af --volumes.',
  },
];
---

<section class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto w-full max-w-6xl">
    <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">the missing verbs</p>
    <div
      class="mt-4 flex flex-col overflow-hidden rounded-sm border border-ink/15 md:h-[22rem] md:flex-row"
    >
      {
        tiles.map((tile) => (
          <article
            class="group relative flex min-h-40 flex-1 flex-col justify-between border-ink/10 bg-core p-5 transition-[flex] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:flex-[2.2] focus-within:flex-[2.2] md:min-h-0 md:border-r md:last:border-r-0"
          >
            <p class="font-mono text-[11px] text-amber">{tile.k}</p>
            <div class="mt-8 md:max-w-[16rem] md:opacity-80 md:transition-opacity md:duration-500 md:group-hover:opacity-100">
              <h2 class="text-xl leading-tight tracking-tight text-ink">{tile.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-mute">{tile.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
