---
import CopyButton from './CopyButton.astro';
---

<div id="sticky-install" class="sticky-install pointer-events-none fixed inset-x-0 bottom-0 z-40 md:bottom-4" data-visible="false" inert>
  <div class="page-container !px-0 md:!px-[var(--gutter)]">
    <div class="pointer-events-auto flex items-center justify-between gap-3 border-t border-line-strong bg-raised/95 px-4 py-2.5 backdrop-blur-xl md:border md:px-3 md:pl-4">
      <p class="min-w-0 truncate font-mono text-[12px] text-soft">
        <span class="text-accent" aria-hidden="true">$</span>
        <span class="hidden sm:inline">curl … install.sh | bash -s -- --with-cli</span>
        <span class="sm:hidden">One curl. Then <span class="text-fg">dc</span>.</span>
      </p>
      <div class="flex shrink-0 items-center gap-1">
        <a href="/play/" data-track-source="sticky" class="btn btn-ghost btn-sm hidden md:inline-flex">Play</a>
        <CopyButton size="sm" statusId="sticky-copy-status" trackSource="sticky" />
      </div>
    </div>
  </div>
  <p id="sticky-copy-status" class="sr-only" aria-live="polite"></p>
</div>

<style>
  .sticky-install {
    transform: translateY(110%);
    opacity: 0;
    transition:
      transform var(--dur-slow) var(--ease),
      opacity var(--dur-base) var(--ease);
  }
  .sticky-install[data-visible='true'] {
    transform: none;
    opacity: 1;
  }
</style>

<script>
  // Visible once the hero is gone, hidden again while the install section is on screen.
  const bar = document.getElementById('sticky-install');
  const hero = document.getElementById('hero');
  const install = document.getElementById('install');
  if (bar && hero && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let installVisible = false;
    const update = () => {
      const show = !heroVisible && !installVisible;
      bar.dataset.visible = show ? 'true' : 'false';
      bar.toggleAttribute('inert', !show);
    };
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      update();
    }).observe(hero);
    if (install) {
      new IntersectionObserver(([entry]) => {
        installVisible = entry.isIntersecting;
        update();
      }).observe(install);
    }
  }
</script>
