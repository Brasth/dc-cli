---
import DemoVideo from './DemoVideo.astro';
---

<section id="tui" class="px-4 py-12 md:px-6 md:py-16" aria-label="dc-tui tour">
  <div class="mx-auto grid w-full max-w-6xl items-start gap-8 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">the board</p>
      <h2 class="mt-3 max-w-xl text-3xl leading-tight tracking-tight text-ink md:text-4xl">
        Every key. One tour.
      </h2>
      <p class="mt-3 max-w-md text-sm text-mute">
        Start, shell, logs, top, nets, more, rm y/n — the same board <span class="font-mono text-ink/80">dc-tui</span> opens in your folder.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href="/play/"
          class="inline-flex min-h-10 items-center bg-ink px-4 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
        >
          Play the board
        </a>
        <a
          href="#board"
          class="inline-flex min-h-10 items-center border border-ink/15 px-4 font-mono text-xs text-ink transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/40"
        >
          Try inline
        </a>
      </div>
    </div>
    <div class="md:col-span-7">
      <div class="overflow-hidden rounded-sm border border-ink/15 bg-core">
        <DemoVideo
          id="tui-tour-video"
          src="/videos/tui-tour.mp4"
          poster="/videos/posters/tui-tour.webp"
          label="dc-tui full feature tour"
          framed
        />
      </div>
    </div>
  </div>
</section>
