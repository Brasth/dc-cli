---
import { latestRelease } from '../lib/schema';
import { installCommand } from '../lib/install';
---

<section id="install" class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto w-full max-w-6xl overflow-hidden rounded-sm border border-ink/15 bg-core">
    <div class="flex items-center justify-between border-b border-ink/10 px-4 py-2">
      <p class="font-mono text-[10px] text-mute">~/ — bash</p>
      <button
        id="copy-install"
        type="button"
        data-install-copy
        data-install-cmd={installCommand}
        class="inline-flex min-h-10 items-center px-2 font-mono text-[11px] text-amber transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        copy
      </button>
    </div>
    <div class="px-4 py-8 md:px-8 md:py-10">
      <h2 class="max-w-3xl text-3xl leading-tight tracking-tight md:text-5xl">
        One curl. Then dc.
      </h2>
      <p class="mt-4 max-w-xl text-sm text-mute">
        This line is helpers + official standalone CLI if missing (<span class="font-mono text-ink/80">--with-cli</span>). Then dc in this folder.
      </p>
      <pre class="mt-8 overflow-x-auto font-mono text-sm leading-relaxed text-ink md:text-base"><span class="text-amber">$</span> <code id="install-cmd" data-cmd={installCommand}></code><span class="cursor-block" aria-hidden="true"></span></pre>
      <p id="copy-status" class="mt-3 min-h-5 font-mono text-[11px] text-amber" aria-live="polite"></p>
      <p class="font-mono text-xs text-mute">source ~/.zshrc <span class="text-ink/30">or</span> ~/.bashrc <span class="text-ink/30">then</span> dc</p>
      <p class="mt-4 font-mono text-xs text-mute">
        or <span class="text-ink/80">brew tap Brasth/dc-cli && brew install dc-cli</span>
      </p>
      <p class="mt-3 max-w-xl text-xs text-mute">
        Tracks the latest GitHub release ({latestRelease}, prebuilt TUI). Safer: clone, then
        <span class="font-mono text-ink/80"> bash install.sh</span>. Clone with no flags stays wrappers only. npm is explicit <span class="font-mono text-ink/80">--with-cli-npm</span> only.
        <a href="/guide/install/" class="text-ink/80 hover:text-ink">--full</a> also copies the agent skill.
      </p>
    </div>
  </div>
</section>

<script>
  const code = document.getElementById('install-cmd');
  const status = document.getElementById('copy-status');
  const full = code?.dataset.cmd ?? '';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (code) {
    if (reduce) {
      code.textContent = full;
    } else {
      let i = 0;
      const tick = () => {
        i += 1;
        code.textContent = full.slice(0, i);
        if (i < full.length) window.setTimeout(tick, 16);
      };
      window.setTimeout(tick, 280);
    }
  }

  // Keep #copy-status in sync when the shared copy handler fires on #copy-install
  document.getElementById('copy-install')?.addEventListener('click', () => {
    window.setTimeout(() => {
      if (status && !status.textContent) status.textContent = 'copied';
    }, 0);
  });
</script>
