---
const install = 'curl -fsSL https://raw.githubusercontent.com/Brasth/dc-cli/main/install.sh | bash';
---

<section id="install" class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto w-full max-w-6xl overflow-hidden rounded-sm border border-ink/15 bg-core">
    <div class="flex items-center justify-between border-b border-ink/10 px-4 py-2">
      <p class="font-mono text-[10px] text-mute">~/ — bash</p>
      <button
        id="copy-install"
        type="button"
        class="inline-flex min-h-10 items-center px-2 font-mono text-[11px] text-amber transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        copy
      </button>
    </div>
    <div class="px-4 py-8 md:px-8 md:py-10">
      <h2 class="max-w-3xl text-3xl leading-tight tracking-tight md:text-5xl">
        One curl. Then source your shell.
      </h2>
      <p class="mt-4 max-w-xl text-sm text-mute">
        Tracks the latest GitHub release. Safer: clone, then
        <span class="font-mono text-ink/80"> bash install.sh</span>.
      </p>
      <pre class="mt-8 overflow-x-auto font-mono text-sm leading-relaxed text-ink md:text-base"><span class="text-amber">$</span> <code id="install-cmd" data-cmd={install}></code><span class="cursor-block" aria-hidden="true"></span></pre>
      <p id="copy-status" class="mt-3 min-h-5 font-mono text-[11px] text-amber" aria-live="polite"></p>
      <p class="font-mono text-xs text-mute">source ~/.zshrc <span class="text-ink/30">or</span> ~/.bashrc</p>
      <p class="mt-3 max-w-xl text-xs text-mute">
        Default curl is wrappers only. <a href="/guide/install/" class="text-ink/80 hover:text-ink">--full</a> if you want official CLI + the agent skill.
      </p>
    </div>
  </div>
</section>

<script>
  const code = document.getElementById('install-cmd');
  const button = document.getElementById('copy-install');
  const status = document.getElementById('copy-status');
  const full = code?.dataset.cmd ?? '';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (code) {
    if (reduce) {
      code.textContent = full;
    } else {
      let i = 0;
      const tick = () => {
        i += 1;
        code.textContent = full.slice(0, i);
        if (i < full.length) window.setTimeout(tick, 16);
      };
      window.setTimeout(tick, 280);
    }
  }

  async function copy() {
    if (!full || !button || !status) return;
    try {
      await navigator.clipboard.writeText(full);
      status.textContent = 'copied — now source your shell';
    } catch {
      status.textContent = 'select the line and copy';
    }
  }

  button?.addEventListener('click', () => {
    void copy();
  });
</script>
