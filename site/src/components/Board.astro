---
/**
 * Browser simulation of the dc-tui board (lib/board-simulator.ts).
 * demo="configured": a running stack. demo="none": first run, no config → dc try.
 * keys="focus": keys only while the board is focused (embedded on the homepage).
 * keys="window": keys anywhere on the page (/play).
 */
interface Props {
  demo?: 'configured' | 'none';
  keys?: 'focus' | 'window';
  class?: string;
}

const { demo = 'configured', keys = 'focus', class: className = '' } = Astro.props;
const label =
  keys === 'focus'
    ? 'Interactive dc-tui demo. Focus here, then press keys or click the buttons.'
    : 'Interactive dc-tui demo. Press keys anywhere on this page, or click the buttons.';
---

<div class:list={['frame', className]}>
  <span class="frame-pip" aria-hidden="true"></span>
  <div class="frame-bar">
    <span>dc-tui · browser simulation</span>
    <span class="board-focus-hint hidden sm:inline">{keys === 'focus' ? 'click or tab in, then type' : 'type anywhere'}</span>
  </div>
  <div
    class="board-frame screen min-h-[24rem]"
    id="board-root"
    data-demo={demo}
    data-keys={keys}
    tabindex="0"
    role="group"
    aria-label={label}
  >
  </div>
</div>

<style>
  .frame:focus-within .board-focus-hint {
    color: var(--accent);
  }
</style>

<script>
  import { mountBoard } from '../lib/board-mount';

  const root = document.getElementById('board-root');
  if (root) mountBoard(root);
</script>
