---
/**
 * Muted, looping terminal recording. Loads its source only when it scrolls
 * near the viewport, pauses off-screen, and shows the poster (no motion)
 * under prefers-reduced-motion.
 */
interface Props {
  src: string;
  poster: string;
  class?: string;
  id?: string;
  /** 16:9 box sized to its container */
  framed?: boolean;
  label?: string;
  /** Start loading immediately (above the fold). */
  eager?: boolean;
}

const { src, poster, class: className = '', id, framed = false, label = 'Product demo', eager = false } = Astro.props;
---

<div
  class:list={['demo-video relative overflow-hidden bg-sunken', framed && 'aspect-video w-full', className]}
  data-demo-video
  data-eager={eager ? 'true' : undefined}
>
  <video
    id={id}
    class="h-full w-full object-cover object-top"
    poster={poster}
    muted
    playsinline
    loop
    preload="none"
    aria-label={label}
    data-demo-src={src}
  >
  </video>
  <img
    class="demo-video-poster absolute inset-0 h-full w-full object-cover object-top"
    src={poster}
    alt={label}
    width="1280"
    height="720"
    decoding="async"
    loading="lazy"
    hidden
  />
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setup(wrap: HTMLElement) {
    const video = wrap.querySelector('video');
    const poster = wrap.querySelector<HTMLImageElement>('.demo-video-poster');
    if (!video) return;

    const showPoster = () => {
      video.pause();
      video.hidden = true;
      if (poster) poster.hidden = false;
    };

    if (reduce.matches) {
      showPoster();
      return;
    }

    const play = () => {
      const src = video.dataset.demoSrc;
      if (src && video.getAttribute('src') !== src) video.src = src;
      void video.play().catch(() => {
        if (poster) poster.hidden = false;
      });
    };

    if (!('IntersectionObserver' in window)) {
      play();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) play();
          else video.pause();
        }
      },
      { rootMargin: wrap.dataset.eager ? '400px 0px' : '120px 0px', threshold: 0.2 },
    );
    io.observe(wrap);
  }

  document.querySelectorAll<HTMLElement>('[data-demo-video]').forEach(setup);
</script>
