---
/**
 * The mark: a host frame around a guest, with a phosphor pip.
 * Pass `label` when the mark stands alone; omit it when text sits beside it.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: className = 'h-7 w-7', label } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <rect x="5" y="5" width="54" height="54" rx="14" stroke="currentColor" stroke-width="2"></rect>
  <rect x="16" y="16" width="32" height="32" rx="8" stroke="currentColor" stroke-width="1.75"></rect>
  <rect x="40" y="12" width="7" height="7" rx="1.5" fill="var(--accent, #6FCF7B)"></rect>
</svg>
