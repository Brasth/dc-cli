---
const rows = [
  { cmd: 'dc-tui', does: 'Clickable board. Start / shell / stop first. t opens top. n lists this folder nets. --all for the fleet.' },
  { cmd: 'dc-doctor', does: 'Read-only diagnose. --json for agents. docker_context is engine + socket. Two live daemons = split_brain blocker.' },
  { cmd: 'dc-engine', does: 'Which Docker engine the CLI talks to. --fix prints recovery. --yes only runs docker context use. Never sudo.' },
  { cmd: 'dc-up', does: 'Start this folder. DC = official CLI + forward. Compose-only = docker compose (no forward). Refuses when two engines are live. --take-ports stops labeled or proven compose-kind holders.' },
  { cmd: 'dc-exec', does: 'Shell in the app. DC = official CLI. Compose = compose exec. --service NAME for siblings. --restart is stack-only.' },
  { cmd: 'dc-down', does: 'Stop the full compose stack. --app for the labeled app only. --all --yes stops every labeled stack. project and .devcontainer are one claimant.' },
  { cmd: 'dc-forward', does: 'Reconcile owned sidecars. One app or --id. Pairs like 9001:80.' },
  { cmd: 'dc-db', does: 'Open TablePlus on a declared db port. --list to classify. Never invents a port.' },
  { cmd: 'dc-files', does: 'yazi/nnn in the box, else Linux yazi copied into /tmp. Never apt-get.' },
  { cmd: 'dc-df', does: 'Docker + Colima disk report. Read-only.' },
  { cmd: 'dc-stats', does: 'CPU / RAM / net for this folder. Read-only. TUI key t. Desktop guest is cap only.' },
  { cmd: 'dc-net', does: 'This folder declared compose nets. --ensure creates missing external:true bridges. TUI key n.' },
  { cmd: 'dc-prune', does: 'Engine-wide cache/images/nets. Owned-only orphans. Dry-run without --yes.' },
];
---

<section class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto grid w-full max-w-6xl gap-8 md:grid-cols-12 md:items-start">
    <div class="md:col-span-4">
      <h2 class="font-mono text-2xl leading-tight tracking-tight md:text-3xl">
        Official CLI has up and exec. This adds the rest.
      </h2>
      <a href="/guide/" class="mt-4 inline-flex min-h-10 items-center font-mono text-xs text-amber hover:text-ink">
        task guides →
      </a>
    </div>
    <ol class="border-t border-ink/10 md:col-span-8">
      {
        rows.map((row) => (
          <li class="grid grid-cols-1 items-baseline gap-1 border-b border-ink/10 py-3 md:grid-cols-12 md:gap-6">
            <code class="font-mono text-xs text-amber md:col-span-3">{row.cmd}</code>
            <p class="text-sm text-ink/80 md:col-span-9">{row.does}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
