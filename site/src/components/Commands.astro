---
const rows = [
  { cmd: 'dc', does: 'Board. Same as dc-tui. --all for the fleet.' },
  { cmd: 'dc up', does: 'Start this folder. Same as dc-up.' },
  { cmd: 'dc exec', does: 'Shell in the app. Same as dc-exec. --service NAME for siblings.' },
  { cmd: 'dc down', does: 'Stop the stack. Same as dc-down.' },
  { cmd: 'dc doctor', does: 'Read-only diagnose. Same as dc-doctor.' },
  { cmd: 'dc recover', does: 'One next step. --yes or TUI [f] applies. Same as dc-recover.' },
  { cmd: 'dc try', does: 'Sandbox when there is no config. Default localhost ports. Same as dc-try.' },
  { cmd: 'dc forward', does: 'Colima-safe ports. Same as dc-forward.' },
  { cmd: 'dc db', does: 'Host DB client on a declared port. Same as dc-db.' },
  { cmd: 'dc files', does: 'yazi/nnn in the box. Same as dc-files.' },
  { cmd: 'dc df', does: 'Disk report. Same as dc-df.' },
  { cmd: 'dc prune', does: 'Safe reclaim. Dry-run without --yes. Same as dc-prune.' },
];
---

<section class="px-4 py-12 md:px-6 md:py-16">
  <div class="mx-auto grid w-full max-w-6xl gap-8 md:grid-cols-12 md:items-start">
    <div class="md:col-span-4">
      <h2 class="font-mono text-2xl leading-tight tracking-tight md:text-3xl">
        Type dc. Then a verb. dc-up still works.
      </h2>
      <p class="mt-3 max-w-sm text-sm text-mute">
        Two spellings, same command. Flags: <span class="font-mono text-ink/80">dc --help</span>.
      </p>
      <a href="/guide/" class="mt-4 inline-flex min-h-10 items-center font-mono text-xs text-amber hover:text-ink">
        task guides →
      </a>
    </div>
    <ol class="border-t border-ink/10 md:col-span-8">
      {
        rows.map((row) => (
          <li class="grid grid-cols-1 items-baseline gap-1 border-b border-ink/10 py-3 md:grid-cols-12 md:gap-6">
            <code class="font-mono text-xs text-amber md:col-span-3">{row.cmd}</code>
            <p class="text-sm text-ink/80 md:col-span-9">{row.does}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
