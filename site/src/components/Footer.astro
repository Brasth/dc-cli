---
import Logo from './Logo.astro';
import ProductHuntBadge from './ProductHuntBadge.astro';
import { latestRelease } from '../lib/schema';

const year = new Date().getFullYear();

const columns = [
  {
    name: 'product',
    links: [
      { href: '/play/', label: 'play', track: 'footer' },
      { href: '/guide/', label: 'guides' },
      { href: '/#install', label: 'install' },
      { href: `https://github.com/Brasth/dc-cli/releases/tag/${latestRelease}`, label: `release ${latestRelease}` },
    ],
  },
  {
    name: 'project',
    links: [
      { href: 'https://github.com/Brasth/dc-cli', label: 'repository' },
      { href: 'https://github.com/Brasth/dc-cli#readme', label: 'readme' },
      { href: '/issues/', label: 'issues' },
      { href: 'https://github.com/devcontainers/cli', label: '@devcontainers/cli' },
    ],
  },
];
---

<footer class="relative z-10 border-t border-line">
  <div class="page-container grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:grid-cols-12 md:py-16">
    <div class="col-span-2 md:col-span-6">
      <a href="/" class="inline-flex min-h-11 items-center gap-2.5 font-mono text-sm text-fg">
        <Logo class="h-6 w-6 text-fg" />
        <span class="font-medium">dc-cli</span>
      </a>
      <p class="t-body mt-3 max-w-[22rem] text-sm">
        Dev containers from your terminal. Wraps the official Dev Containers CLI.
      </p>
      <ProductHuntBadge class="mt-6" theme="dark" />
    </div>
    {
      columns.map((col) => (
        <nav class="col-span-1 md:col-span-3" aria-label={col.name}>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">{col.name}</h2>
          <ul class="mt-3 grid">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-track-source={link.track}
                  class="inline-flex min-h-10 items-center font-mono text-xs text-soft transition-colors duration-[var(--dur-base)] hover:text-fg"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="page-container">
    <div class="flex flex-col gap-2 border-t border-line py-6 font-mono text-[11px] text-muted sm:flex-row sm:justify-between">
      <p>MIT · {year} · Canvilled / Brasth</p>
      <p>{latestRelease}</p>
    </div>
  </div>
</footer>
