---
import { latestRelease } from '../lib/schema';

const year = new Date().getFullYear();
---

<footer class="px-4 pb-10 md:px-6 md:pb-12">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-4 border-t border-ink/10 pt-6 font-mono text-xs md:flex-row md:items-center md:justify-between"
  >
    <p class="text-mute">MIT. {year}. Canvilled / Brasth. {latestRelease}</p>
    <div class="flex flex-wrap gap-5">
      <a class="text-ink/75 hover:text-ink" href={`https://github.com/Brasth/dc-cli/releases/tag/${latestRelease}`}>
        {latestRelease}
      </a>
      <a class="text-ink/75 hover:text-ink" href="/guide/">guides</a>
      <a class="text-ink/75 hover:text-ink" href="/issues/">issues</a>
      <a class="text-ink/75 hover:text-ink" href="https://github.com/Brasth/dc-cli">repository</a>
      <a class="text-ink/75 hover:text-ink" href="https://github.com/Brasth/dc-cli#readme">readme</a>
      <a class="text-ink/75 hover:text-ink" href="https://github.com/devcontainers/cli">@devcontainers/cli</a>
    </div>
  </div>
</footer>
