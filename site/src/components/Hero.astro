---
import DemoVideo from './DemoVideo.astro';
import CopyButton from './CopyButton.astro';
import CommandText from './CommandText.astro';
import { installCommand } from '../lib/install';

const facts = [
  { k: 'wraps', v: 'the official Dev Containers CLI' },
  { k: 'never edits', v: 'the project’s .devcontainer' },
  { k: 'no VS Code', v: 'required — any editor, or none' },
  { k: 'runs on', v: 'macOS and Linux · MIT' },
];

const replay = [
  { cmd: 'dc', out: 'lists the verbs for this folder' },
  { cmd: 'dc up', out: 'kind=devcontainer → started, ports forwarded' },
  { cmd: 'dc', out: 'opens the board' },
];
---

<section id="hero" class="relative pt-[calc(var(--nav-h)+clamp(2.5rem,1.5rem+4vw,5rem))]" aria-labelledby="hero-title">
  <div class="page-container">
    <p class="prompt rise">
      <span>~/src/app</span><span class="sigil">$</span><span class="cmd-text">dc</span>
    </p>
    <h1 id="hero-title" class="t-display rise rise-2 mt-5 max-w-[14ch] lg:max-w-none">
      Dev containers <span class="text-muted lg:block">from your terminal.</span>
    </h1>

    <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:gap-8">
      <!-- Copy + install -->
      <div class="rise rise-3 flex flex-col lg:col-span-5 lg:pr-6">
        <p class="t-lede max-w-[34rem]">
          <span class="cmd-chip">dc up</span> starts this folder. No config?
          <span class="cmd-chip">dc try</span>. No VS Code required.
        </p>
        <p class="t-body mt-4 max-w-[34rem]">
          A daily workspace hub for the terminal: favorites and recent folders, pinned actions, and
          session activity, built on the official Dev Containers CLI.
        </p>

        <div class="install-line mt-8">
          <div class="panel flex min-w-0 items-stretch overflow-hidden">
            <span class="flex items-center pl-4 pr-2 font-mono text-sm text-accent" aria-hidden="true">$</span>
            <code class="min-w-0 flex-1 py-3.5 pr-4 font-mono text-[13px] leading-5 text-fg"><CommandText cmd={installCommand} /></code>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <CopyButton id="hero-copy-install" statusId="hero-copy-status" trackSource="hero" />
            <a href="/play/" data-track-source="hero" class="btn btn-outline">Play in the browser</a>
          </div>
          <p id="hero-copy-status" class="mt-3 min-h-5 font-mono text-[12px] text-accent" aria-live="polite"></p>
          <p class="mt-1 flex flex-wrap items-center gap-x-1 font-mono text-[12px] text-muted">
            <span>or read</span>
            <a href="/guide/" class="link inline-flex min-h-11 items-center px-1">the guides</a>
            <span aria-hidden="true">·</span>
            <a href="https://github.com/Brasth/dc-cli" class="link inline-flex min-h-11 items-center px-1">the source on GitHub</a>
          </p>
        </div>
      </div>

      <!-- Product -->
      <figure class="rise rise-3 lg:col-span-7">
        <div class="frame">
          <span class="frame-pip" aria-hidden="true"></span>
          <div class="frame-bar">
            <span>terminal recording</span>
            <span class="hidden sm:inline">no editor in the loop</span>
          </div>
          <div class="screen">
            <DemoVideo
              id="hero-video"
              src="/videos/hero.mp4"
              poster="/videos/posters/hero.webp"
              label="Terminal recording: dc lists its verbs, dc up starts a devcontainer and forwards ports, then dc opens the board"
              framed
              eager
            />
          </div>
        </div>
        <figcaption class="mt-4 grid gap-x-6 gap-y-2 font-mono text-[12px] leading-5 sm:grid-cols-3">
          {
            replay.map((step) => (
              <span class="flex flex-col">
                <span class="text-fg"><span class="text-accent">$</span> {step.cmd}</span>
                <span class="text-muted">{step.out}</span>
              </span>
            ))
          }
        </figcaption>
      </figure>
    </div>

    <ul class="mt-16 grid grid-cols-1 border-y border-line sm:grid-cols-2 lg:mt-20 lg:grid-cols-4" aria-label="Guarantees">
      {
        facts.map((fact, i) => (
          <li
            class:list={[
              'flex items-baseline gap-3 py-4 sm:px-5 lg:py-5',
              i > 0 && 'border-t border-line sm:border-t-0',
              i % 2 === 1 && 'sm:border-l sm:border-line',
              i === 2 && 'lg:border-l lg:border-line',
              i >= 2 && 'sm:border-t sm:border-line lg:border-t-0',
              i === 0 && 'sm:pl-0',
            ]}
          >
            <span class="mt-[0.35em] h-1.5 w-1.5 flex-none rounded-[1px] bg-accent" aria-hidden="true" />
            <span class="text-[15px] leading-6">
              <span class="font-medium text-fg">{fact.k}</span> <span class="text-muted">{fact.v}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
