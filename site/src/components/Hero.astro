---
import Logo from './Logo.astro';
import DemoVideo from './DemoVideo.astro';
import { installCommand } from '../lib/install';
---

<section
  id="hero"
  class="relative isolate min-h-[100svh] overflow-hidden"
  aria-label="Introduction"
>
  <DemoVideo
    fill
    id="hero-video"
    src="/videos/hero.mp4"
    poster="/videos/posters/hero.webp"
    label="dc-cli terminal demo"
    class="hero-video-plane"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-page via-page/80 to-page/50"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-page via-page/70 to-transparent md:from-page/95 md:via-page/55"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 flex min-h-[100svh] flex-col justify-end px-4 pb-20 pt-24 md:justify-center md:px-6 md:pb-24 md:pt-28">
    <div class="hero-rise mx-auto w-full max-w-6xl md:pt-8">
      <p class="flex items-center gap-3 font-mono text-sm text-ink md:text-base">
        <Logo class="h-8 w-8 md:h-10 md:w-10" />
        <span class="tracking-tight">dc-cli</span>
      </p>
      <h1
        class="mt-5 max-w-3xl font-mono text-[clamp(2.1rem,5.2vw,4.25rem)] leading-[0.95] font-medium tracking-[-0.06em] text-ink drop-shadow-[0_2px_24px_rgba(7,8,6,0.85)]"
      >
        Host-global helpers around the official Dev Containers CLI.
      </h1>
      <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-mute md:text-base">
        Start, exec, stop, ports, doctor, disk. No VS Code required. Does not edit project
        <span class="font-mono text-ink/80">.devcontainer</span>.
      </p>
      <div class="mt-7 flex flex-wrap gap-2">
        <button
          id="hero-copy-install"
          type="button"
          data-install-cmd={installCommand}
          class="inline-flex min-h-10 items-center bg-ink px-4 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
        >
          Copy install
        </button>
        <a
          href="#demo"
          class="inline-flex min-h-10 items-center border border-ink/20 bg-page/40 px-4 font-mono text-xs text-ink backdrop-blur-sm transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/45"
        >
          Watch
        </a>
        <a
          href="https://github.com/Brasth/dc-cli"
          class="inline-flex min-h-10 items-center px-4 font-mono text-xs text-mute transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-ink"
        >
          GitHub
        </a>
      </div>
      <p id="hero-copy-status" class="mt-3 min-h-5 font-mono text-[11px] text-amber" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rise = document.querySelector<HTMLElement>('.hero-rise');
  if (rise && !reduce) {
    rise.style.opacity = '0';
    rise.style.transform = 'translateY(16px)';
    requestAnimationFrame(() => {
      rise.style.transition =
        'opacity 700ms cubic-bezier(0.32,0.72,0,1), transform 700ms cubic-bezier(0.32,0.72,0,1)';
      rise.style.opacity = '1';
      rise.style.transform = 'translateY(0)';
    });
  }

  const btn = document.getElementById('hero-copy-install');
  const status = document.getElementById('hero-copy-status');
  btn?.addEventListener('click', async () => {
    const cmd = btn.getAttribute('data-install-cmd') ?? '';
    try {
      await navigator.clipboard.writeText(cmd);
      if (status) status.textContent = 'copied — paste in your terminal';
    } catch {
      window.location.hash = 'install';
      if (status) status.textContent = 'jump to install';
    }
  });
</script>
