---
const install = 'curl -fsSL https://raw.githubusercontent.com/Canvilled/dc-cli/main/install.sh | bash';
---

<section class="relative min-h-[100dvh] px-4 pb-24 pt-36 md:px-8 md:pb-40 md:pt-44">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center text-center">
    <h1
      class="max-w-6xl text-[clamp(3rem,5vw,5.5rem)] leading-[0.95] font-medium tracking-[-0.045em] text-ink"
    >
      Host-global helpers around the official CLI.
    </h1>
    <p class="mt-8 max-w-xl text-lg leading-relaxed text-mute">
      Start, exec, stop, ports, disk. No VS Code required. Does not edit project
      <span class="font-mono text-ink/80"> .devcontainer</span>.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#install"
        class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-base font-medium text-page transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        Copy install
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-page/10 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px"
          aria-hidden="true">↗</span
        >
      </a>
      <a
        href="https://github.com/Brasth/dc-cli"
        class="inline-flex items-center rounded-full border border-ink/15 px-6 py-3 text-base text-ink transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/40"
      >
        GitHub
      </a>
    </div>
    <p class="mt-6 max-w-3xl font-mono text-[11px] leading-relaxed break-all text-mute sm:text-xs">
      {install}
    </p>
  </div>

  <div class="mx-auto mt-20 w-full max-w-6xl md:mt-28">
    <div class="rounded-[2rem] border border-ink/10 bg-ink/5 p-1.5">
      <div class="overflow-hidden rounded-[calc(2rem-0.375rem)] bg-core shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)]">
        <img
          id="tui-shot"
          src="/images/tui.png"
          alt="dc-tui board with start, shell, open, attach, ports, stop, and stack rows"
          width="1512"
          height="496"
          class="h-auto w-full outline outline-1 outline-white/10"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const shot = document.getElementById('tui-shot');
  if (!reduce && shot) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.fromTo(
      shot,
      { scale: 0.8, opacity: 0.35 },
      {
        scale: 1,
        opacity: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: shot,
          start: 'top 90%',
          end: 'top 35%',
          scrub: true,
        },
      },
    );
  }
</script>
