---
const install = 'curl -fsSL https://raw.githubusercontent.com/Brasth/dc-cli/main/install.sh | bash';
---

<section class="relative px-4 pb-10 pt-20 md:px-6 md:pb-12 md:pt-24">
  <div class="mx-auto grid w-full max-w-6xl items-end gap-8 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-5">
      <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">host frame / guest box</p>
      <h1
        class="mt-3 max-w-xl font-mono text-[clamp(2.4rem,5.4vw,4.4rem)] leading-[0.92] font-medium tracking-[-0.06em] text-ink"
      >
        Host-global helpers.
      </h1>
      <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-mute">
        Around official <span class="font-mono text-ink/80">@devcontainers/cli</span>.
        Start, exec, stop, ports, disk. No VS Code required. Does not edit project
        <span class="font-mono text-ink/80"> .devcontainer</span>.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a
          href="#install"
          class="inline-flex min-h-10 items-center bg-ink px-4 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
        >
          copy install
        </a>
        <a
          href="https://github.com/Brasth/dc-cli"
          class="inline-flex min-h-10 items-center border border-ink/15 px-4 font-mono text-xs text-ink transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/40"
        >
          github
        </a>
      </div>
      <p class="mt-4 font-mono text-[10px] leading-relaxed break-all text-mute">{install}</p>
    </div>

    <div class="md:col-span-7 md:-mb-4 md:translate-x-3">
      <div class="overflow-hidden rounded-sm border border-ink/15 bg-core shadow-[0_0_0_1px_rgb(0_0_0/0.4)]">
        <div class="flex items-center gap-2 border-b border-ink/10 px-3 py-2">
          <span class="h-2 w-2 rounded-full bg-ink/20"></span>
          <span class="h-2 w-2 rounded-full bg-ink/20"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber"></span>
          <p class="ml-2 truncate font-mono text-[10px] text-mute">dc-tui — ~/src/app</p>
        </div>
        <img
          id="tui-shot"
          src="/images/tui.png"
          alt="dc-tui board with start, shell, open, attach, ports, stop, and stack rows"
          width="1512"
          height="496"
          class="h-auto w-full outline outline-1 outline-white/10"
        />
      </div>
    </div>
  </div>
</section>
