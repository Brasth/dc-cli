---
import { latestRelease } from '../lib/schema';

const boot = ['docker  ok', 'devcontainer  ok', 'dc-doctor  usable', 'host  ready'];
---

<section class="relative px-4 pb-6 pt-20 md:px-6 md:pb-8 md:pt-24">
  <div class="mx-auto grid w-full max-w-6xl items-end gap-6 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">
        host frame / guest box · latest {latestRelease}
      </p>
      <h1
        class="mt-3 font-mono text-[clamp(2.6rem,6.4vw,5.2rem)] leading-[0.88] font-medium tracking-[-0.07em] text-ink"
      >
        The missing<br />verbs for<br />devcontainers.
      </h1>
    </div>
    <div class="md:col-span-5 md:pb-2">
      <ol class="space-y-1 font-mono text-[12px] text-mute" id="boot-lines">
        {
          boot.map((line) => (
            <li class="boot-line">
              <span class="text-amber">▸</span> {line}
            </li>
          ))
        }
      </ol>
      <p class="mt-4 max-w-sm text-[14px] leading-relaxed text-mute">
        Official CLI has <span class="text-ink">up</span> and <span class="text-ink">exec</span>.
        This adds stop, ports, doctor, disk, fleet, and a clickable TUI. Does not edit project
        <span class="font-mono text-ink/80"> .devcontainer</span>.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a
          href="#install"
          class="inline-flex min-h-10 items-center bg-ink px-4 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
        >
          copy install
        </a>
        <a
          href="#board"
          class="inline-flex min-h-10 items-center border border-ink/15 px-4 font-mono text-xs text-ink transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/40"
        >
          play the board
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lines = document.querySelectorAll<HTMLElement>('.boot-line');
  if (!reduce) {
    lines.forEach((line, i) => {
      line.style.opacity = '0';
      line.style.transform = 'translateY(8px)';
      window.setTimeout(() => {
        line.style.transition = 'opacity 400ms cubic-bezier(0.32,0.72,0,1), transform 400ms cubic-bezier(0.32,0.72,0,1)';
        line.style.opacity = '1';
        line.style.transform = 'translateY(0)';
      }, 90 * i);
    });
  }
</script>
