---
import Logo from './Logo.astro';
---

<header class="fixed inset-x-0 top-0 z-30 border-b border-ink/10 bg-page/80 backdrop-blur-2xl">
  <nav
    class="mx-auto flex h-12 w-full max-w-6xl items-center justify-between gap-4 px-4 md:px-6"
    aria-label="Primary"
  >
    <a href="#top" class="flex min-h-10 items-center gap-2 font-mono text-sm text-ink">
      <Logo class="h-5 w-5" />
      <span>dc-cli</span>
      <span class="hidden text-mute sm:inline">~/project</span>
    </a>
    <div class="flex items-center gap-1">
      <a
        href="https://github.com/Brasth/dc-cli"
        class="inline-flex min-h-10 items-center px-3 font-mono text-xs text-mute transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-ink"
      >
        github
      </a>
      <a
        href="#install"
        class="inline-flex min-h-10 items-center bg-amber px-3 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        $ install
      </a>
    </div>
  </nav>
</header>
