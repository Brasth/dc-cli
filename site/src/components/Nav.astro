---
import Logo from './Logo.astro';
---

<header class="fixed inset-x-0 top-0 z-30 border-b border-ink/10 bg-page/80 px-4 backdrop-blur-2xl md:px-6">
  <nav
    class="mx-auto flex h-12 w-full max-w-6xl items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a href="/" class="flex min-h-10 items-center gap-2 font-mono text-sm text-ink">
      <Logo class="h-5 w-5" />
      <span>dc-cli</span>
      <span class="hidden text-mute sm:inline">~/project</span>
    </a>
    <div class="flex items-center gap-1">
      <span id="nav-clock" class="hidden px-3 font-mono text-[11px] tabular-nums text-mute sm:inline">00:00:00</span>
      <a
        href="/guide/"
        class="inline-flex min-h-10 items-center px-3 font-mono text-xs text-mute transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-ink"
      >
        guide
      </a>
      <a
        href="https://github.com/Brasth/dc-cli"
        class="inline-flex min-h-10 items-center px-3 font-mono text-xs text-mute transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-ink"
      >
        github
      </a>
      <a
        href="/#install"
        class="inline-flex min-h-10 items-center bg-amber px-3 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        $ install
      </a>
    </div>
  </nav>
</header>

<script>
  const clock = document.getElementById('nav-clock');
  const pad = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    if (!clock) return;
    const d = new Date();
    clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  };
  tick();
  window.setInterval(tick, 1000);
</script>
