---
import { installCommand } from '../lib/install';
---

<section id="why" class="px-4 py-14 md:px-6 md:py-20" aria-label="Why dc-cli">
  <div class="pain-reveal mx-auto w-full max-w-6xl">
    <p class="font-mono text-[11px] tracking-[0.18em] text-amber uppercase">why install</p>
    <h2 class="mt-3 max-w-3xl text-3xl leading-tight tracking-tight text-ink md:text-5xl">
      Same folder. Missing verbs — until you type <span class="font-mono text-amber">dc</span>.
    </h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-mute md:text-base">
      Host-global wrappers around the official CLI. No VS Code required. Never edits project
      <span class="font-mono text-ink/80">.devcontainer</span>.
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <p class="font-mono text-[11px] tracking-[0.14em] text-mute uppercase">without</p>
        <ul class="mt-4 space-y-3 font-mono text-[13px] leading-relaxed text-mute">
          <li><span class="text-ink/35">—</span> Dig through VS Code Remote UI</li>
          <li><span class="text-ink/35">—</span> Remember raw <span class="text-ink/70">docker exec</span> names</li>
          <li><span class="text-ink/35">—</span> Hand-roll Colima port sidecars</li>
          <li><span class="text-ink/35">—</span> Guess which engine owns this folder</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-[11px] tracking-[0.14em] text-amber uppercase">with dc</p>
        <ul class="mt-4 space-y-3 font-mono text-[13px] leading-relaxed text-ink/85">
          <li><span class="text-amber">▸</span> <span class="text-amber">dc up</span> — start this folder</li>
          <li><span class="text-amber">▸</span> <span class="text-amber">dc exec</span> — shell, never raw docker exec</li>
          <li><span class="text-amber">▸</span> <span class="text-amber">dc doctor</span> — read-only diagnose</li>
          <li><span class="text-amber">▸</span> <span class="text-amber">dc forward</span> — Colima-safe ports</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-2">
      <button
        type="button"
        data-install-copy
        data-install-cmd={installCommand}
        class="inline-flex min-h-10 items-center bg-amber px-4 font-mono text-xs text-page transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.96]"
      >
        Copy install
      </button>
      <a
        href="#install"
        class="inline-flex min-h-10 items-center border border-ink/15 px-4 font-mono text-xs text-ink transition-colors duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-ink/40"
      >
        See the curl
      </a>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.querySelector<HTMLElement>('.pain-reveal');
  if (el && !reduce && 'IntersectionObserver' in window) {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          el.style.transition =
            'opacity 600ms cubic-bezier(0.32,0.72,0,1), transform 600ms cubic-bezier(0.32,0.72,0,1)';
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(el);
  }
</script>
